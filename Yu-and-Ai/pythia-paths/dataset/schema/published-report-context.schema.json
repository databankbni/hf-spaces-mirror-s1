{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pythia-paths:schema:published-piqa-context:0.1",
  "title": "Pythia Paths published PIQA report context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "context_id",
    "source_reviewed_at",
    "declared_ref",
    "step",
    "tokens_seen",
    "tokens_seen_status",
    "tokens_seen_method",
    "task",
    "metric",
    "value",
    "stderr",
    "source_repo",
    "source_commit",
    "source_path",
    "source_blob_sha1",
    "evaluated_model_commit",
    "evaluated_artifact_digest",
    "metric_to_model_artifact_binding",
    "comparison_status",
    "detailed_receipt_in_this_release",
    "carried_action_authority"
  ],
  "properties": {
    "schema": { "const": "pythia-paths/published-piqa-context/0.1" },
    "context_id": { "type": "string", "pattern": "^pythia-70m-deduped:step[0-9]+:piqa:acc_norm:published-report-context$" },
    "source_reviewed_at": { "type": "string", "format": "date-time" },
    "declared_ref": { "type": "string", "pattern": "^step[0-9]+$" },
    "step": { "type": "integer", "minimum": 0, "maximum": 143000 },
    "tokens_seen": { "type": "integer", "minimum": 0 },
    "tokens_seen_status": { "const": "derived" },
    "tokens_seen_method": { "const": "step * 2097152" },
    "task": { "const": "piqa" },
    "metric": { "const": "acc_norm" },
    "value": { "type": "number", "minimum": 0, "maximum": 1 },
    "stderr": { "type": "number", "minimum": 0 },
    "source_repo": { "const": "EleutherAI/pythia" },
    "source_commit": { "const": "a19eecb807ec2c79a39ebf18108816e6ffffc1d5" },
    "source_path": {
      "type": "string",
      "pattern": "^evals/pythia-v1/pythia-70m-deduped/zero-shot/70m-deduped_step[0-9]+\\.json$"
    },
    "source_blob_sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "evaluated_model_commit": { "type": "null" },
    "evaluated_artifact_digest": { "type": "null" },
    "metric_to_model_artifact_binding": { "const": "not_proven" },
    "comparison_status": { "const": "not_proven" },
    "detailed_receipt_in_this_release": { "type": "boolean" },
    "carried_action_authority": { "const": false }
  }
}
