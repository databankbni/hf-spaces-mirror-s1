/* =====================================================================
   looper · recorder  (records MIDI events; plays solo or inside the track)
   ===================================================================== */
const REC={state:'idle',events:[],t0:0,timeouts:[],playing:false,quantize:true};
const tInfo=$('#tInfo');

function recCapture(type,midi,vel){
  if(REC.state!=='rec'||REC.playing)return;
  const now=performance.now();
  if(REC.events.length===0)REC.t0=now;
  const ev={t:(now-REC.t0)/1000,type,midi};
  if(type==='on')ev.vel=(vel==null?0.8:vel);
  REC.events.push(ev);
  recInfo();
}
function quantizeEvents(evs){
  if(!REC.quantize||!evs.length)return evs.slice();
  const grid=spb();                                   // snap to 1/16 at current BPM
  return evs.map(e=>({...e,t:Math.round(e.t/grid)*grid}));
}
function recInfo(msg){
  if(msg){tInfo.textContent=msg;return;}
  const n=REC.events.filter(e=>e.type==='on').length;
  tInfo.textContent=REC.events.length
    ? n+' NOTES'+(REC.quantize?' · quantized':'')
    : 'EMPTY — hit REC and play';
}
function recStopSolo(){
  REC.timeouts.forEach(clearTimeout);REC.timeouts=[];
  REC.playing=false;REC.state='idle';
  $('#tRec').classList.remove('on','rec-blink');
  $('#tPlay').classList.remove('play-on');
  allOff();recInfo();
}
function recPlaySolo(){
  if(!REC.events.length){recInfo('NOTHING TO PLAY — record first');return;}
  recStopSolo();ensureAudio();REC.playing=true;REC.state='play';
  $('#tPlay').classList.add('play-on');
  const evs=quantizeEvents(REC.events);
  const end=Math.max(...evs.map(e=>e.t))+Math.max(.3,P.e1.r);
  for(const e of evs)REC.timeouts.push(setTimeout(()=>{
    e.type==='on'?voiceOn(e.midi,e.vel):voiceOff(e.midi,true);},e.t*1000));
  REC.timeouts.push(setTimeout(recStopSolo,end*1000));
  recInfo('▶ PLAYING RIFF');
}
$('#tRec').onclick=()=>{
  if(REC.state==='rec'){REC.state='idle';$('#tRec').classList.remove('on','rec-blink');recInfo();
    /* stop automation recording alongside the looper */
    if(AUTOM.recording)autoStopRec();
    return;}
  recStopSolo();ensureAudio();
  REC.events=[];REC.state='rec';
  $('#tRec').classList.add('on','rec-blink');
  recInfo('● RECORDING — play + move knobs to capture automation…');
  /* also arm automation capture so live knob moves are recorded with the riff */
  autoStartRec();
};
$('#tPlay').onclick=recPlaySolo;
$('#tStop').onclick=recStopSolo;
$('#tQuant').onclick=e=>{REC.quantize=!REC.quantize;e.target.classList.toggle('on',REC.quantize);recInfo();};
$('#tClear').onclick=()=>{recStopSolo();REC.events=[];recInfo();};

/* ---- riff scheduling inside the track loop ---- */
let qRiff=[];
function rescheduleRiff(){
  /* wrap recorded events into one loop so the riff repeats cleanly */
  const L=loopLen();
  qRiff=quantizeEvents(REC.events).map(e=>({...e,t:L>0?((e.t%L)+L)%L:e.t}));
}
function fireRiffWindow(from,to){
  if(!qRiff.length)return;
  const L=loopLen();
  const rel0=((from-TR.loopStart)%L+L)%L;   // position within current loop
  const rel1=rel0+(to-from);
  for(const e of qRiff){
    /* fire if e.t falls in [rel0,rel1); handle wrap at loop boundary */
    const hit = (e.t>=rel0&&e.t<rel1) || (rel1>L && e.t<(rel1-L));
    if(hit){
      const when=from+(e.t-rel0+(e.t<rel0?L:0));
      e.type==='on'?scheduleNoteOn(e.midi,when,e.vel):scheduleNoteOff(e.midi,when);
    }
  }
}
