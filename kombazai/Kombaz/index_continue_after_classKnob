/* ---- per-channel drum sample loading ---- */
const DSAMPLES={};  // ch -> AudioBuffer
function loadSampleForChannel(ch,file){
  const reader=new FileReader();
  reader.onload=e=>{
    ensureAudio();
    AC.decodeAudioData(e.target.result.slice(0)).then(buf=>{
      DSAMPLES[ch]=buf;
      document.querySelectorAll(`#drumPads .pad[data-ch="${ch}"]`).forEach(p=>{
        p.classList.add('has-sample');p.title=ch+' · '+file.name.slice(0,20);
      });
    }).catch(()=>{});
  };
  reader.readAsArrayBuffer(file);
}
function triggerWithSample(ch,t){
  /* if a sample is loaded, play it; otherwise use the synthesized voice */
  if(DSAMPLES[ch]&&AC){
    const src=AC.createBufferSource();src.buffer=DSAMPLES[ch];
    const g=AC.createGain();g.gain.value=DMIX[ch];
    src.connect(g).connect(dOut(ch));src.start(t);
  }else{TRIG[ch](t);}
}

/* =====================================================================
   Performance Pads — instant one-shots that always work, even while the
   track / beat is playing. Supports hold-to-repeat and multi-touch.
   ===================================================================== */
const PAD_REPEAT_MS=130;            // retrigger interval while held
const padHolds=new Map();           // ch -> interval id
function padFire(ch,pad){
  ensureAudio();
  if(!AC||!TRIG[ch])return;
  if(AC.state==='suspended')AC.resume();
  /* schedule a hair ahead of "now" so it never lands in the past while the
     scheduler is busy during playback — this is what makes it reliable live */
  const when=Math.max(AC.currentTime,AC.currentTime+0.005);
  try{triggerWithSample(ch,when);}catch(_){}
  if(pad){pad.classList.add('hit');setTimeout(()=>pad.classList.remove('hit'),80);}
}
function padHoldStart(ch,pad){
  padFire(ch,pad);
  if(padHolds.has(ch))clearInterval(padHolds.get(ch));
  /* only repeat for sustained-ish channels; one-shots like crash still repeat
     but at the hold rate, which feels like a roll — that's desirable live */
  padHolds.set(ch,setInterval(()=>padFire(ch,pad),PAD_REPEAT_MS));
}
function padHoldStop(ch){
  if(padHolds.has(ch)){clearInterval(padHolds.get(ch));padHolds.delete(ch);}
}
/* Daft Punk style pad colors — one per channel, inspired by the "Harder Better Faster Stronger" pad grid */
const PAD_COLORS={
  KICK:  {bg:'#c0392b',glow:'#e74c3c'},  // deep red
  KICK2: {bg:'#922b21',glow:'#e74c3c'},  // dark red
  BASS:  {bg:'#7d3c98',glow:'#9b59b6'},  // purple
  SNARE: {bg:'#1a5276',glow:'#2980b9'},  // blue
  HAT:   {bg:'#1e8449',glow:'#27ae60'},  // green
  OHAT:  {bg:'#196f3d',glow:'#27ae60'},  // dark green
  CLAP:  {bg:'#d4ac0d',glow:'#f1c40f'},  // yellow
  RIDE:  {bg:'#d35400',glow:'#e67e22'},  // orange
  CRASH: {bg:'#b03a2e',glow:'#e74c3c'},  // red-orange
  PERC:  {bg:'#17a589',glow:'#1abc9c'},  // teal
};
function buildPads(){
  const host=$('#drumPads');if(!host)return;host.innerHTML='';
  DRUM_CHANNELS.forEach((ch,i)=>{
    const col=PAD_COLORS[ch]||{bg:'#2a3040',glow:'#2ee6ff'};
    const p=document.createElement('div');p.className='pad';p.dataset.ch=ch;
    p.style.cssText=`--pad-bg:${col.bg};--pad-glow:${col.glow};background:${col.bg};border-color:${col.bg};`;
    p.innerHTML=`<span class="pad-name">${ch}</span><small>${i<9?(i+1):'0'}</small>`;
    /* pointer events */
    p.addEventListener('pointerdown',e=>{
      e.preventDefault();try{p.setPointerCapture(e.pointerId);}catch(_){}
      padHoldStart(ch,p);
    });
    const release=()=>padHoldStop(ch);
    p.addEventListener('pointerup',release);p.addEventListener('pointercancel',release);
    p.addEventListener('lostpointercapture',release);
    p.addEventListener('pointerleave',e=>{if(e.buttons)padHoldStop(ch);});
    /* drag WAV */
    p.addEventListener('dragover',e=>{e.preventDefault();p.classList.add('drag-over');});
    p.addEventListener('dragleave',()=>p.classList.remove('drag-over'));
    p.addEventListener('drop',e=>{e.preventDefault();p.classList.remove('drag-over');
      const f=e.dataTransfer.files[0];if(f&&(f.type.startsWith('audio')||f.name.match(/\.(wav|mp3|ogg|flac)$/i)))loadSampleForChannel(ch,f);});
    p.addEventListener('contextmenu',e=>{e.preventDefault();
      if(DSAMPLES[ch]){delete DSAMPLES[ch];p.classList.remove('has-sample');p.title=ch;}});
    host.appendChild(p);
  });
}
