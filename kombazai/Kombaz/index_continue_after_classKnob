/* =====================================================================
   OFFLINE RENDER ENGINE (self-contained; mirrors the live voices)
   Used only for WAV export via OfflineAudioContext.
   ===================================================================== */
function buildGraph(ctx){
  const bus=ctx.createGain();bus.gain.value=P.m.vol;
  const sh=ctx.createWaveShaper();sh.curve=driveCurve(P.x.dist);sh.oversample='2x';
  const chIn=ctx.createGain(),chDry=ctx.createGain(),chWet=ctx.createGain(),chSum=ctx.createGain();
  const d1=ctx.createDelay(.06),d2=ctx.createDelay(.06);d1.delayTime.value=.013;d2.delayTime.value=.019;
  chIn.connect(chDry);chIn.connect(d1);chIn.connect(d2);
  d1.connect(chWet);d2.connect(chWet);chDry.connect(chSum);chWet.connect(chSum);
  chWet.gain.value=P.x.chor;chDry.gain.value=1;
  const dl=ctx.createDelay(1.5),fb=ctx.createGain(),dtone=ctx.createBiquadFilter(),dWet=ctx.createGain();
  dl.delayTime.value=P.x.dtime;fb.gain.value=P.x.dfb;dWet.gain.value=P.x.dmix;
  dtone.type='lowpass';dtone.frequency.value=4500;dl.connect(dtone).connect(fb).connect(dl);
  const cv=ctx.createConvolver();{const len=ctx.sampleRate*2.2,b=ctx.createBuffer(2,len,ctx.sampleRate);
    for(let c=0;c<2;c++){const dd=b.getChannelData(c);for(let i=0;i<len;i++)dd[i]=(Math.random()*2-1)*Math.pow(1-i/len,3.2);}cv.buffer=b;}
  const vWet=ctx.createGain();vWet.gain.value=P.x.verb;
  const comp=ctx.createDynamicsCompressor();comp.threshold.value=-10;comp.ratio.value=4;
  const duck=ctx.createGain();duck.gain.value=1;
  const drumFilt=ctx.createBiquadFilter();drumFilt.type='lowpass';drumFilt.frequency.value=DFILT.cut;drumFilt.Q.value=DFILT.res;
  const drumGains={};DRUM_CHANNELS.forEach(r=>{
    const dg=ctx.createGain();dg.gain.value=DMIX[r];
    const dr=ctx.createWaveShaper();dr.curve=driveCurve(DSND[r].drive||0);dr.oversample='2x';
    dg.connect(dr).connect(drumFilt);
    const vs=ctx.createGain();vs.gain.value=DSND[r].verb||0;dr.connect(vs).connect(cv);
    drumGains[r]=dg;});
  drumFilt.connect(comp);
  bus.connect(sh).connect(chIn);
  chSum.connect(duck);duck.connect(comp);
  chSum.connect(dl);dl.connect(dWet).connect(duck);
  chSum.connect(cv);cv.connect(vWet).connect(duck);
  /* FX insert chain in offline render */
  const fx=buildFXChain(ctx);
  comp.connect(fx.input);fx.output.connect(ctx.destination);
  const wa=ctx.createPeriodicWave(new Float32Array(NH+1),morphTable(P.a.pos));
  const wb=ctx.createPeriodicWave(new Float32Array(NH+1),morphTable(P.b.pos));
  return {bus,comp,duck,drumGains,drumFilt,waves:{a:wa,b:wb},held:{},
    fxNodes:{chWet,dl,fb,dWet,vWet,bus}};
}
function offlineNoteOn(ctx,eng,midi,t,vel){
  vel=(vel==null?0.8:vel);
  const mod=evalModMatrix(vel,midi);
  const f0=440*Math.pow(2,(midi-69)/12);
  const vGain=ctx.createGain();vGain.gain.value=0;
  const flt=ctx.createBiquadFilter();flt.type=P.f.type;flt.Q.value=P.f.res;
  flt.connect(vGain).connect(eng.bus);
  const oscs={a:[],b:[]};
  for(const w of ['a','b']){const cfg=P[w];if(cfg.lvl<=0.001)continue;
    const grp=ctx.createGain();grp.gain.value=cfg.lvl/Math.sqrt(cfg.uni);
    const pan0=ctx.createStereoPanner();pan0.pan.value=clamp(cfg.pan+(mod.pan||0),-1,1);grp.connect(pan0).connect(flt);
    buildOscVoice(ctx,cfg,eng.waves[w],f0,t,grp,oscs[w],null);
  }
  const e=P.e1;
  const velAmp=1-(mod.ampVelDepth||0)*(1-vel);
  vGain.gain.setValueAtTime(0,t);
  vGain.gain.linearRampToValueAtTime(velAmp,t+Math.max(.002,e.a));
  vGain.gain.setTargetAtTime(e.s*velAmp,t+Math.max(.002,e.a),Math.max(.01,e.d/3));
  const m=P.e2,base=clamp(P.f.cut*Math.pow(2,mod.cutoff||0),20,18000);
  const peak=clamp(base*Math.pow(2,P.f.env),20,18000),sus=clamp(base*Math.pow(2,P.f.env*m.s),20,18000);
  flt.frequency.setValueAtTime(base,t);
  flt.frequency.linearRampToValueAtTime(peak,t+Math.max(.002,m.a));
  flt.frequency.setTargetAtTime(sus,t+Math.max(.002,m.a),Math.max(.01,m.d/3));
  let subOsc=null;
  if(P.sub.lvl>0.001){
    subOsc=ctx.createOscillator();subOsc.type=P.sub.wave;
    subOsc.frequency.value=f0*Math.pow(2,P.sub.oct);
    const sg=ctx.createGain();sg.gain.value=P.sub.lvl;
    subOsc.connect(sg).connect(vGain);subOsc.start(t);
  }
  eng.held[midi]={oscs,flt,vGain,subOsc};
}
function offlineNoteOff(eng,midi,t){
  const v=eng.held[midi];if(!v)return;delete eng.held[midi];
  const r=Math.max(.02,P.e1.r);
  v.vGain.gain.setTargetAtTime(0,t,r/3);
  const stop=t+r*4+.1;
  for(const w of ['a','b'])v.oscs[w].forEach(o=>{try{o.stop(stop)}catch(e){}});
  if(v.subOsc){try{v.subOsc.stop(stop)}catch(e){}}
}
/* offline drum voices (route to per-channel mixer gain; kick pumps the duck) */
function dOutO(e,ch){return (e.drumGains&&e.drumGains[ch])||e.comp;}
function pumpO(e,t){if(!e.duck||P.sc.amt<=0)return;const d=e.duck.gain,depth=1-P.sc.amt;
  d.setValueAtTime(depth,t);d.setTargetAtTime(1,t+0.005,Math.max(.03,P.sc.rel)/3);}
const DRUMS_OFFLINE={
  KICK:(c,e,t)=>{const o=c.createOscillator(),g=c.createGain(),p=pf('KICK'),d=dc('KICK');
    o.frequency.setValueAtTime(150*p,t);o.frequency.exponentialRampToValueAtTime(45*p,t+.12*d);
    g.gain.setValueAtTime(1.0,t);g.gain.exponentialRampToValueAtTime(.001,t+.32*d);
    o.connect(g).connect(dOutO(e,'KICK'));o.start(t);o.stop(t+.34*d);pumpO(e,t);},
  KICK2:(c,e,t)=>{const p=pf('KICK2'),d=dc('KICK2'),out=dOutO(e,'KICK2');
    const len=c.sampleRate*.5,b=c.createBuffer(1,len,c.sampleRate);
    const dd=b.getChannelData(0);for(let i=0;i<len;i++)dd[i]=Math.random()*2-1;
    const cs=c.createBufferSource();cs.buffer=b;const cf=c.createBiquadFilter();cf.type='bandpass';cf.frequency.value=2600;cf.Q.value=1.2;
    const cg=c.createGain();cg.gain.setValueAtTime(.5,t);cg.gain.exponentialRampToValueAtTime(.001,t+.012);
    cs.connect(cf).connect(cg).connect(out);cs.start(t);cs.stop(t+.03);
    const o=c.createOscillator();o.type='sine';const g=c.createGain();
    o.frequency.setValueAtTime(330*p,t);o.frequency.exponentialRampToValueAtTime(58*p,t+.045*d);o.frequency.exponentialRampToValueAtTime(44*p,t+.16*d);
    g.gain.setValueAtTime(0,t);g.gain.linearRampToValueAtTime(1.15,t+.003);g.gain.exponentialRampToValueAtTime(.001,t+.22*d);
    const sh=c.createWaveShaper();sh.curve=driveCurve(.25);
    o.connect(sh).connect(g).connect(out);o.start(t);o.stop(t+.24*d);pumpO(e,t);},
  BASS:(c,e,t)=>{const o=c.createOscillator(),g=c.createGain(),f=c.createBiquadFilter(),p=pf('BASS'),d=dc('BASS');
    o.type='sawtooth';o.frequency.setValueAtTime(58*p,t);f.type='lowpass';f.frequency.value=220;f.Q.value=6;
    g.gain.setValueAtTime(0,t);g.gain.linearRampToValueAtTime(.7,t+.004);g.gain.exponentialRampToValueAtTime(.001,t+.11*d);
    o.connect(f).connect(g).connect(dOutO(e,'BASS'));o.start(t);o.stop(t+.13*d);},
  _noise:(c,e,t,dur,hpf,gain,ch)=>{const len=c.sampleRate*.5,b=c.createBuffer(1,len,c.sampleRate);
    const dd=b.getChannelData(0);for(let i=0;i<len;i++)dd[i]=Math.random()*2-1;
    const tone=DSND[ch||'PERC']?.tone??0.5,d=dc(ch||'PERC');
    const s=c.createBufferSource();s.buffer=b;const f=c.createBiquadFilter();f.type='highpass';
    f.frequency.value=hpf*pf(ch||'PERC')*(0.4+tone*1.6);const len2=dur*d;
    const g=c.createGain();g.gain.setValueAtTime(gain,t);g.gain.exponentialRampToValueAtTime(.001,t+len2);
    s.connect(f).connect(g).connect(dOutO(e,ch||'PERC'));s.start(t);s.stop(t+len2+.02);},
  HAT:(c,e,t)=>DRUMS_OFFLINE._noise(c,e,t,.04,8000,.35,'HAT'),
  OHAT:(c,e,t)=>DRUMS_OFFLINE._noise(c,e,t,.18,7000,.3,'OHAT'),
  RIDE:(c,e,t)=>DRUMS_OFFLINE._noise(c,e,t,.25,9000,.16,'RIDE'),
  CRASH:(c,e,t)=>DRUMS_OFFLINE._noise(c,e,t,.9,5000,.32,'CRASH'),
  CLAP:(c,e,t)=>{DRUMS_OFFLINE._noise(c,e,t,.02,1500,.4,'CLAP');DRUMS_OFFLINE._noise(c,e,t+.01,.02,1500,.4,'CLAP');DRUMS_OFFLINE._noise(c,e,t+.025,.12,1200,.45,'CLAP');},
  SNARE:(c,e,t)=>{DRUMS_OFFLINE._noise(c,e,t,.16,1800,.4,'SNARE');const o=c.createOscillator(),g=c.createGain(),p=pf('SNARE'),d=dc('SNARE');
    o.type='triangle';o.frequency.setValueAtTime(180*p,t);g.gain.setValueAtTime(.4,t);g.gain.exponentialRampToValueAtTime(.001,t+.1*d);
    o.connect(g).connect(dOutO(e,'SNARE'));o.start(t);o.stop(t+.12*d);},
  PERC:(c,e,t)=>{const o=c.createOscillator(),g=c.createGain(),p=pf('PERC'),d=dc('PERC');
    o.type='triangle';o.frequency.setValueAtTime(420*p,t);o.frequency.exponentialRampToValueAtTime(180*p,t+.08*d);
    g.gain.setValueAtTime(.4,t);g.gain.exponentialRampToValueAtTime(.001,t+.1*d);
    o.connect(g).connect(dOutO(e,'PERC'));o.start(t);o.stop(t+.12*d);}
};

