  if(typeof applyMutesSolos==='function')applyMutesSolos();
  if(d.preset&&PRESETS[d.preset]){$('#preset').value=d.preset;applyPreset(d.preset);}
  if(d.params){for(const sec in d.params)Object.assign(P[sec]||{},d.params[sec]);syncAllKnobs();
    K.scamt&&K.scamt.set(P.sc.amt,false);K.screl&&K.screl.set(P.sc.rel,false);}
