/* ---- snapshot helper (shared by autosave + undo) ---- */
function snapshot(){
  return {P:JSON.parse(JSON.stringify(P)),MOD:JSON.parse(JSON.stringify(MODMATRIX)),
    DMIX:{...DMIX},DMUTE:{...DMUTE},DSND:JSON.parse(JSON.stringify(DSND)),DFILT:{...DFILT},
    drum:{bpm:DRUM.bpm,bars:DRUM.bars,kit:DRUM.kit,swing:DRUM.swing,
      patterns:JSON.parse(JSON.stringify(DRUM.patterns)),chain:DRUM.chain.slice(),active:DRUM.active},
    arp:{on:ARP.on,mode:ARP.mode,rate:ARP.rate,octaves:ARP.octaves,gate:ARP.gate},
    chord:{on:CHORD.on,type:CHORD.type,inv:CHORD.inv},
    mel:{on:MEL.on,follow:MEL.follow,bank:MEL.bank,
      banks:Object.fromEntries(Object.entries(MEL.banks).map(([k,v])=>[k,v.map(s=>({...s}))])),
      soundOf:{...MEL.soundOf}},
    riffb:{follow:RIFFB.follow,bank:RIFFB.bank,
      banks:Object.fromEntries(Object.entries(RIFFB.banks).map(([k,v])=>[k,(k===RIFFB.bank?REC.events:v).map(e=>({...e}))]))},
    song:{cells:SONG.cells.map(row=>row.slice())},
    events:JSON.parse(JSON.stringify(REC.events)),
    autom:AUTOM.events.slice(),
    light:lightMode,preset:$('#preset').value};
}
let saveTimer=null;
function saveState(){
  clearTimeout(saveTimer);
  saveTimer=setTimeout(()=>{
    try{localStorage.setItem('kombaz_state',JSON.stringify(snapshot()));}catch(e){}
  },600);
}
function applySnapshot(s){
  if(!s)return false;
  try{
    if(s.P)for(const sec in s.P)Object.assign(P[sec]||{},s.P[sec]);
    if(s.MOD){MODMATRIX=JSON.parse(JSON.stringify(s.MOD));buildModMatrix();}
    if(s.DMIX)Object.assign(DMIX,s.DMIX);
    if(s.DSND)for(const c in s.DSND)if(DSND[c])Object.assign(DSND[c],s.DSND[c]);
    if(s.DFILT)Object.assign(DFILT,s.DFILT);
    if(s.events)REC.events=JSON.parse(JSON.stringify(s.events));
    if(s.drum){DRUM.bpm=s.drum.bpm||145;DRUM.bars=s.drum.bars||1;DRUM.kit=s.drum.kit||'psy';
      DRUM.swing=s.drum.swing||0;
      if(s.drum.patterns)PAT_NAMES.forEach(pn=>{if(s.drum.patterns[pn]){DRUM.patterns[pn]={};
        DRUM.rows.forEach(r=>{const a=(s.drum.patterns[pn][r]||[]).slice(0,steps());
          while(a.length<steps())a.push(false);DRUM.patterns[pn][r]=a;});}});
      DRUM.active=s.drum.active&&PAT_NAMES.includes(s.drum.active)?s.drum.active:'A';
      DRUM.grid=DRUM.patterns[DRUM.active];
      DRUM.chain=Array.isArray(s.drum.chain)&&s.drum.chain.length?s.drum.chain.slice():['A'];}
    if(s.arp){ARP.on=!!s.arp.on;ARP.mode=s.arp.mode||'up';ARP.rate=s.arp.rate||4;
      ARP.octaves=s.arp.octaves||1;ARP.gate=s.arp.gate||.6;}
    lightMode=!!s.light;
    /* push to UI */
    $('#bpm').value=DRUM.bpm;$('#bars').value=DRUM.bars;$('#kit').value=DRUM.kit;
    $('#swing').value=DRUM.swing;$('#swingVal').textContent=Math.round(DRUM.swing/0.7*100)+'%';
    buildSeq();paintSeq();renderChain();recInfo();
    document.querySelectorAll('#patTabs button[data-p]').forEach(b=>b.classList.toggle('on',b.dataset.p===DRUM.active));
    document.querySelectorAll('#mixFaders .mfader').forEach((d,i)=>{const ch=DRUM_CHANNELS[i];if(!ch)return;
      const inp=d.querySelector('input'),out=d.querySelector('output');inp.value=DMIX[ch];out.textContent=Math.round(DMIX[ch]*100);});
    K.dcut&&K.dcut.set(DFILT.cut,false);K.dres&&K.dres.set(DFILT.res,false);
    K.arpRate&&K.arpRate.set(ARP.rate,false);K.arpOct&&K.arpOct.set(ARP.octaves,false);K.arpGate&&K.arpGate.set(ARP.gate,false);
    $('#arpToggle').textContent=ARP.on?'ON':'OFF';$('#arpToggle').classList.toggle('on',ARP.on);
    document.querySelectorAll('#arpMode button').forEach(b=>b.classList.toggle('on',b.dataset.v===ARP.mode));
    if(ROLL&&ROLL.open)drawRoll();
    syncAllKnobs();applyTheme();
    if(AC&&master.drumDrives)DRUM_CHANNELS.forEach(ch=>{
      if(master.drumDrives[ch])master.drumDrives[ch].curve=driveCurve(DSND[ch].drive||0);
      if(master.drumVerbSends[ch])master.drumVerbSends[ch].gain.value=DSND[ch].verb||0;});
    /* restore mute */
    if(s.DMUTE)DRUM_CHANNELS.forEach(ch=>{if(s.DMUTE[ch]!=null)DMUTE[ch]=s.DMUTE[ch];});
    /* restore chord mode */
    if(s.chord){CHORD.on=!!s.chord.on;CHORD.type=s.chord.type||'maj';CHORD.inv=s.chord.inv||0;CHORD._map={};
      $('#chordToggle').textContent=CHORD.on?'ON':'OFF';$('#chordToggle').classList.toggle('on',CHORD.on);
      document.querySelectorAll('#chordType button').forEach(b=>b.classList.toggle('on',b.dataset.v===CHORD.type));
      document.querySelectorAll('#chordInv button').forEach(b=>b.classList.toggle('on',b.dataset.v==CHORD.inv));}
    /* restore melody sequencer (banked format, with legacy fallback) */
    if(s.mel){MEL.on=!!s.mel.on;
      $('#melToggle').textContent=MEL.on?'ON':'OFF';$('#melToggle').classList.toggle('on',MEL.on);
      if(s.mel.banks){for(const k in s.mel.banks){if(MEL.banks[k])MEL.banks[k]=s.mel.banks[k].map(st=>({...st}));}
        MEL.follow=s.mel.follow!==false;MEL.soundOf=Object.assign({A:'',B:'',C:'',D:''},s.mel.soundOf||{});
        $('#melFollow')&&$('#melFollow').classList.toggle('on',MEL.follow);
        melSetBank(s.mel.bank||'A',false);}
      else if(Array.isArray(s.mel.steps)){s.mel.steps.forEach((st,i)=>{if(MEL.banks.A[i])Object.assign(MEL.banks.A[i],st);});melSetBank('A',false);}
      buildMelGrid();}
    /* restore riff banks */
    if(s.riffb&&s.riffb.banks){
      for(const k in s.riffb.banks){if(RIFFB.banks[k]!==undefined)RIFFB.banks[k]=s.riffb.banks[k].map(e2=>({...e2}));}
      RIFFB.follow=s.riffb.follow!==false;RIFFB.bank=s.riffb.bank||'A';
      REC.events=RIFFB.banks[RIFFB.bank];riffPaintTabs();
      $('#riffFollow')&&$('#riffFollow').classList.toggle('on',RIFFB.follow);}
    /* restore song arrangement */
    if(s.song&&Array.isArray(s.song.cells)){
      s.song.cells.forEach((row,pi)=>{if(Array.isArray(row)&&SONG.cells[pi])row.forEach((v,c)=>{if(c<SONG_COLS)SONG.cells[pi][c]=!!v;});});
      buildSongGrid();}
    if(Array.isArray(s.autom))AUTOM.events=s.autom.slice();
    return true;
  }catch(e){return false;}
}
function loadState(){
  let s;try{s=JSON.parse(localStorage.getItem('kombaz_state')||'null');}catch(e){return false;}
  return applySnapshot(s);
}

/* ---- Undo / Redo ---- */
const UNDO={stack:[],redo:[],max:40,suspend:false};
function pushUndo(){
  if(UNDO.suspend)return;
  UNDO.stack.push(snapshot());
  if(UNDO.stack.length>UNDO.max)UNDO.stack.shift();
  UNDO.redo.length=0;
  updateUndoButtons();
}
function doUndo(){
  if(!UNDO.stack.length)return;
  UNDO.redo.push(snapshot());
  const s=UNDO.stack.pop();
  UNDO.suspend=true;applySnapshot(s);UNDO.suspend=false;
  saveState();updateUndoButtons();
}
function doRedo(){
  if(!UNDO.redo.length)return;
  UNDO.stack.push(snapshot());
  const s=UNDO.redo.pop();
  UNDO.suspend=true;applySnapshot(s);UNDO.suspend=false;
  saveState();updateUndoButtons();
}
function updateUndoButtons(){
  const u=$('#undoBtn'),r=$('#redoBtn');
  if(u)u.disabled=!UNDO.stack.length;
  if(r)r.disabled=!UNDO.redo.length;
}
/* capture an undo snapshot before a change; debounced so dragging a knob = 1 entry */
let undoTimer=null,undoPending=false;
function markChange(){
  if(UNDO.suspend)return;
  if(!undoPending){undoPending=true;pushUndo();}
  clearTimeout(undoTimer);
  undoTimer=setTimeout(()=>{undoPending=false;},500);
}
/* keyboard shortcuts */
window.addEventListener('keydown',e=>{
  if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==='z'){
    e.preventDefault();if(e.shiftKey)doRedo();else doUndo();}
  else if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==='y'){e.preventDefault();doRedo();}
});
/* hook saveState + undo capture into key interactions */
['#bpm','#bars','#swing','#kit'].forEach(s=>{const el=$(s);if(el)el.addEventListener('change',saveState);});
/* capture undo snapshot at the start of an edit gesture inside the synth */
$('#synth').addEventListener('pointerdown',e=>{
  /* ignore the keyboard + transport play to avoid noise */
  if(e.target.closest('#kb')||e.target.closest('#drumPads'))return;
  markChange();
},true);
document.addEventListener('pointerup',saveState);
$('#undoBtn').onclick=doUndo;
$('#redoBtn').onclick=doRedo;
updateUndoButtons();
