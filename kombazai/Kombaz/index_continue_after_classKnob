/* register service worker for offline.
   Prefers ./sw.js (full setup on HF). If it's missing — e.g. you copied only
   index.html — falls back to an inline worker so the app still works offline. */
if('serviceWorker' in navigator){
  window.addEventListener('load',async()=>{
    try{
      const r=await fetch('sw.js',{method:'HEAD'});
      if(r.ok){await navigator.serviceWorker.register('sw.js');return;}
      throw 0;
    }catch(e){
      const swCode=`
        const C='kombaz-inline-v1';
        self.addEventListener('install',e=>{self.skipWaiting();});
        self.addEventListener('activate',e=>{e.waitUntil(self.clients.claim());});
        self.addEventListener('fetch',e=>{
          if(e.request.method!=='GET'||e.request.url.includes('/api/'))return;
          e.respondWith(
            caches.open(C).then(c=>c.match(e.request).then(hit=>{
              const net=fetch(e.request).then(res=>{c.put(e.request,res.clone());return res;}).catch(()=>hit);
              return hit||net;
            }))
          );
        });`;
      const url=URL.createObjectURL(new Blob([swCode],{type:'application/javascript'}));
      try{await navigator.serviceWorker.register(url);}catch(_){}
    }
  });
}

