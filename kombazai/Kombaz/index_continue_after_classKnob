let scopeMode='wave';   // 'wave' | 'spectrum'
function drawScope(){
  requestAnimationFrame(drawScope);
  const c=$('#scope'); if(!c||!AC)return;
  const [g,W,H]=setupCanvas(c);
  g.clearRect(0,0,W,H);
  if(scopeMode==='spectrum'){
    const bins=new Uint8Array(master.an.frequencyBinCount);
    master.an.getByteFrequencyData(bins);
    const n=64,step=Math.floor(bins.length/n);
    const bw=W/n;
    for(let i=0;i<n;i++){
      let v=0;for(let j=0;j<step;j++)v+=bins[i*step+j];v/=step;
      const h=v/255*H;
      const hue=200-i/n*160;
      g.fillStyle=`hsl(${hue},90%,60%)`;
      g.fillRect(i*bw+0.5,H-h,bw-1,h);
    }
    g.fillStyle='rgba(124,132,151,.7)';g.font='8px JetBrains Mono';g.fillText('SPECTRUM',6,10);
  }else{
    const buf=new Uint8Array(master.an.fftSize);
    master.an.getByteTimeDomainData(buf);
    g.strokeStyle='#2ee6ff';g.lineWidth=1.5;g.shadowColor='#2ee6ff';g.shadowBlur=6;
    g.beginPath();
    for(let i=0;i<buf.length;i++){const x=i/buf.length*W, y=buf[i]/255*H;
      i?g.lineTo(x,y):g.moveTo(x,y);}
    g.stroke();g.shadowBlur=0;
    g.fillStyle='rgba(124,132,151,.7)';g.font='8px JetBrains Mono';g.fillText('WAVE',6,10);
  }
}
