const KB=$('#kb'), NOTES=24, BASE=()=>48+P.octShift*12; // C3
const keyEls=new Map();
function buildKB(){
  KB.innerHTML='';keyEls.clear();
  const whites=[];for(let i=0;i<NOTES;i++){const pc=i%12;
    if(![1,3,6,8,10].includes(pc))whites.push(i);}
  const ww=100/whites.length;
  whites.forEach((i,wi)=>{
    const el=document.createElement('div');el.className='wk';
    el.style.left=wi*ww+'%';el.style.width=ww+'%';
    KB.appendChild(el);keyEls.set(i,el);bindKey(el,i);
  });
  for(let i=0;i<NOTES;i++){const pc=i%12;
