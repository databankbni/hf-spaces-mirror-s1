/* ---------- MIDI EXPORT (Standard MIDI File from the recorded riff) ---------- */
function exportMidi(){
  if(!REC.events.length){alert('Record a riff first — MIDI export uses your recorded notes.');return;}
  const PPQ=480, bpm=DRUM.bpm;
  const secToTicks=s=>Math.round(s*(bpm/60)*PPQ);
  /* build sorted timed events */
  const evs=quantizeEvents(REC.events).slice().sort((a,b)=>a.t-b.t);
  /* variable-length quantity encoder */
  function vlq(n){const bytes=[n&0x7f];n>>=7;while(n>0){bytes.unshift((n&0x7f)|0x80);n>>=7;}return bytes;}
  const track=[];
  let lastTick=0;
  /* tempo meta */
  const mpqn=Math.round(60000000/bpm);
  track.push(0x00,0xFF,0x51,0x03,(mpqn>>16)&0xff,(mpqn>>8)&0xff,mpqn&0xff);
  for(const e of evs){
    const tick=secToTicks(e.t), delta=Math.max(0,tick-lastTick);lastTick=tick;
    const vel=e.type==='on'?Math.round((e.vel==null?0.8:e.vel)*127):0;
    track.push(...vlq(delta), e.type==='on'?0x90:0x80, e.midi&0x7f, vel&0x7f);
  }
  track.push(0x00,0xFF,0x2F,0x00);  // end of track
  /* assemble file */
  function str(s){return [...s].map(c=>c.charCodeAt(0));}
  function u32(n){return [(n>>24)&0xff,(n>>16)&0xff,(n>>8)&0xff,n&0xff];}
  function u16(n){return [(n>>8)&0xff,n&0xff];}
  const header=[...str('MThd'),...u32(6),...u16(0),...u16(1),...u16(PPQ)];
  const trackChunk=[...str('MTrk'),...u32(track.length),...track];
  const bytes=new Uint8Array([...header,...trackChunk]);
  const blob=new Blob([bytes],{type:'audio/midi'});
  const a=document.createElement('a');
  a.href=URL.createObjectURL(blob);a.download='kombaz-riff-'+Date.now()+'.mid';a.click();
  setTimeout(()=>URL.revokeObjectURL(a.href),8000);
}
