/* ---------- RISER / SWEEP — one-shot build-up effect ---------- */
function triggerRiser(dur){
  ensureAudio();
  dur=dur||(60/DRUM.bpm*4); // ~1 bar by default
  const t=AC.currentTime, out=master.fx?master.fx.input:master.comp;
  /* rising filtered noise */
  const len=AC.sampleRate*(dur+0.3);
  const buf=AC.createBuffer(1,len,AC.sampleRate);
  const d=buf.getChannelData(0);for(let i=0;i<len;i++)d[i]=Math.random()*2-1;
  const src=AC.createBufferSource();src.buffer=buf;
  const bp=AC.createBiquadFilter();bp.type='bandpass';bp.Q.value=4;
  bp.frequency.setValueAtTime(300,t);
  bp.frequency.exponentialRampToValueAtTime(9000,t+dur);
  const g=AC.createGain();
  g.gain.setValueAtTime(0.0001,t);
  g.gain.exponentialRampToValueAtTime(0.35,t+dur);
  g.gain.linearRampToValueAtTime(0,t+dur+0.08);   // quick cut at the drop
  src.connect(bp).connect(g).connect(out);
  src.start(t);src.stop(t+dur+0.3);
  /* rising sine sweep underneath */
  const o=AC.createOscillator();o.type='sawtooth';
  o.frequency.setValueAtTime(110,t);o.frequency.exponentialRampToValueAtTime(880,t+dur);
  const og=AC.createGain();og.gain.setValueAtTime(0.0001,t);
  og.gain.exponentialRampToValueAtTime(0.12,t+dur);og.gain.linearRampToValueAtTime(0,t+dur+0.05);
  o.connect(og).connect(out);o.start(t);o.stop(t+dur+0.1);
  /* button feedback */
  const b=$('#riserBtn');b.classList.add('flash');setTimeout(()=>b.classList.remove('flash'),dur*1000);
}
$('#riserBtn').onclick=()=>triggerRiser();

