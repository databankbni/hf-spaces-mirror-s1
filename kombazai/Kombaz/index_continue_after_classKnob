/* ---- synthesized drum voices (route to per-channel mixer gain) ---- */
function dOut(ch){return (master.drumGains&&master.drumGains[ch])||master.comp;}
function pumpSidechain(t){
  if(!master.duck||P.sc.amt<=0)return;
  const d=master.duck.gain, depth=1-P.sc.amt;
  d.cancelScheduledValues(t);
  d.setValueAtTime(depth,t);                       // duck down instantly on kick
  d.setTargetAtTime(1,t+0.005,Math.max(.03,P.sc.rel)/3); // recover
}
/* per-channel modifiers: pitch (±12 semis → freq mult) and decay (length mult) */
function pf(ch){return Math.pow(2,(DSND[ch]?.pitch||0)/12);}
function dc(ch){return DSND[ch]?.decay||1;}
function dKick(t){const o=AC.createOscillator(),g=AC.createGain(),p=pf('KICK'),d=dc('KICK');
  o.frequency.setValueAtTime(150*p,t);o.frequency.exponentialRampToValueAtTime(45*p,t+.12*d);
  g.gain.setValueAtTime(1.0,t);g.gain.exponentialRampToValueAtTime(.001,t+.32*d);
  o.connect(g).connect(dOut('KICK'));o.start(t);o.stop(t+.34*d);
  pumpSidechain(t);}
/* KICK2 — psytrance kick (Astrix / Infected Mushroom style):
   sharp click transient + punchy tonk body + tight fast sub drop */
function dKick2(t){const p=pf('KICK2'),d=dc('KICK2'),out=dOut('KICK2');
  // 1) click transient (very short noise burst, band-passed high)
  const cs=AC.createBufferSource();cs.buffer=getNoise();
  const cf=AC.createBiquadFilter();cf.type='bandpass';cf.frequency.value=2600;cf.Q.value=1.2;
  const cg=AC.createGain();cg.gain.setValueAtTime(.5,t);cg.gain.exponentialRampToValueAtTime(.001,t+.012);
  cs.connect(cf).connect(cg).connect(out);cs.start(t);cs.stop(t+.03);
  // 2) punchy body — fast pitch sweep from a high "tonk" down to sub
  const o=AC.createOscillator();o.type='sine';
  const g=AC.createGain();
  o.frequency.setValueAtTime(330*p,t);
  o.frequency.exponentialRampToValueAtTime(58*p,t+.045*d);   // fast snap = the psy punch
  o.frequency.exponentialRampToValueAtTime(44*p,t+.16*d);    // settle into tight sub
  g.gain.setValueAtTime(0,t);g.gain.linearRampToValueAtTime(1.15,t+.003);
  g.gain.exponentialRampToValueAtTime(.001,t+.22*d);
  // slight saturation for the "knock"
  const sh=AC.createWaveShaper();sh.curve=driveCurve(.25);
  o.connect(sh).connect(g).connect(out);o.start(t);o.stop(t+.24*d);
  pumpSidechain(t);}
function dBass(t){const o=AC.createOscillator(),g=AC.createGain(),f=AC.createBiquadFilter(),p=pf('BASS'),d=dc('BASS');
  o.type='sawtooth';o.frequency.setValueAtTime(58*p,t);
  f.type='lowpass';f.frequency.setValueAtTime(220,t);f.Q.value=6;
  g.gain.setValueAtTime(0,t);g.gain.linearRampToValueAtTime(.7,t+.004);g.gain.exponentialRampToValueAtTime(.001,t+.11*d);
  o.connect(f).connect(g).connect(dOut('BASS'));o.start(t);o.stop(t+.13*d);}
let noiseBuf=null;
function getNoise(){if(noiseBuf)return noiseBuf;
  noiseBuf=AC.createBuffer(1,AC.sampleRate*.5,AC.sampleRate);
  const d=noiseBuf.getChannelData(0);for(let i=0;i<d.length;i++)d[i]=Math.random()*2-1;return noiseBuf;}
function noiseHit(t,dur,hpf,gain,ch){const s=AC.createBufferSource();s.buffer=getNoise();
  const tone=DSND[ch||'PERC']?.tone??0.5;
  const f=AC.createBiquadFilter();f.type='highpass';
  f.frequency.value=hpf*pf(ch||'PERC')*(0.4+tone*1.6);   // tone brightens/darkens
  const dd=dur*dc(ch||'PERC');
  const g=AC.createGain();g.gain.setValueAtTime(gain,t);g.gain.exponentialRampToValueAtTime(.001,t+dd);
  s.connect(f).connect(g).connect(dOut(ch||'PERC'));s.start(t);s.stop(t+dd+.02);}
const dHat =t=>noiseHit(t,.04,8000,.35,'HAT');
const dOHat=t=>noiseHit(t,.18,7000,.3,'OHAT');
const dRide=t=>noiseHit(t,.25,9000,.16,'RIDE');
const dCrash=t=>noiseHit(t,.9,5000,.32,'CRASH');
function dSnare(t){noiseHit(t,.16,1800,.4,'SNARE');
  const o=AC.createOscillator(),g=AC.createGain(),p=pf('SNARE'),d=dc('SNARE');o.type='triangle';o.frequency.setValueAtTime(180*p,t);
  g.gain.setValueAtTime(.4,t);g.gain.exponentialRampToValueAtTime(.001,t+.1*d);
  o.connect(g).connect(dOut('SNARE'));o.start(t);o.stop(t+.12*d);}
function dClap(t){noiseHit(t,.02,1500,.4,'CLAP');noiseHit(t+.01,.02,1500,.4,'CLAP');noiseHit(t+.025,.12,1200,.45,'CLAP');}
function dPerc(t){const o=AC.createOscillator(),g=AC.createGain(),p=pf('PERC'),d=dc('PERC');
  o.type='triangle';o.frequency.setValueAtTime(420*p,t);o.frequency.exponentialRampToValueAtTime(180*p,t+.08*d);
  g.gain.setValueAtTime(.4,t);g.gain.exponentialRampToValueAtTime(.001,t+.1*d);
  o.connect(g).connect(dOut('PERC'));o.start(t);o.stop(t+.12*d);}
const TRIG={KICK:dKick,KICK2:dKick2,BASS:dBass,SNARE:dSnare,HAT:dHat,OHAT:dOHat,CLAP:dClap,RIDE:dRide,CRASH:dCrash,PERC:dPerc};

/* ---- shared transport clock ----
   spb = seconds per 16th. loopLen = whole loop in seconds.
   When TRACK is running, both drums and the recorded riff schedule against loopStart. */
function spb(){return 60/DRUM.bpm/4;}
function loopLen(){return steps()*spb();}
let TR={mode:null,loopStart:0,step:0,schedTimer:null,nextStep:0};

function trigStep(step,when,gridOverride){
  const grid=gridOverride||DRUM.grid;
  DRUM.rows.forEach(r=>{if(grid[r][step])triggerWithSample(r,when);});
  /* metronome click on each quarter note (every 4 steps) */
  if(METRO.on&&step%4===0&&AC){
    const o=AC.createOscillator(),g=AC.createGain();
    o.frequency.value=step===0?1600:1000;  // accent on beat 1
    g.gain.setValueAtTime(0.0001,when);g.gain.exponentialRampToValueAtTime(0.25,when+.001);
    g.gain.exponentialRampToValueAtTime(0.0001,when+.04);
    o.connect(g).connect(AC.destination);o.start(when);o.stop(when+.05);
  }
  setTimeout(()=>highlightStep(step),Math.max(0,(when-AC.currentTime)*1000));
}
const METRO={on:false};
$('#metroBtn')&&($('#metroBtn').onclick=()=>{METRO.on=!METRO.on;
  $('#metroBtn').classList.toggle('on',METRO.on);});

