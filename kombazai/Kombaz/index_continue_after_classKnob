/* =====================================================================
   displays
   ===================================================================== */
function setupCanvas(c){const r=c.getBoundingClientRect();
  c.width=r.width*devicePixelRatio;c.height=r.height*devicePixelRatio;
  const g=c.getContext('2d');g.scale(devicePixelRatio,devicePixelRatio);return [g,r.width,r.height];}

function drawWT(which,posOverride){
  const c=$(which==='a'?'#wtA':'#wtB'); if(!c)return;
  const [g,W,H]=setupCanvas(c);
  const accent=which==='a'?'#2ee6ff':'#b388ff';
  const cfg=P[which], eng=cfg.eng||'wt';
  const pos=posOverride!==undefined?posOverride:cfg.pos;
  g.clearRect(0,0,W,H);

  if(eng!=='wt'){
    /* single representative waveform for FM / analog / additive / vocal / pulse */
    let s;
    if(eng==='analog'){s=[];for(let x=0;x<160;x++)s.push(1-2*(x/160));}
    else if(eng==='fm'){s=[];for(let x=0;x<160;x++){const ph=x/160*2*Math.PI;
      s.push(Math.sin(ph+cfg.fm*4*Math.sin(ph*(cfg.fmRatio||2))));}}
    else if(eng==='pulse'){const w=0.1+pos*0.4;s=[];for(let x=0;x<160;x++)s.push(x/160<w?1:-1);}
    else if(eng==='supersaw'){s=[];for(let x=0;x<160;x++){let v=0;
      for(let j=0;j<7;j++){const ph=(x/160+j*0.04*(pos+.2))%1;v+=(1-2*ph);}s.push(v/7);}}
    else if(eng==='granular'){s=[];for(let x=0;x<160;x++){let v=0;
      for(let g=0;g<6;g++){const ph=(x/160+g*0.18)%1;v+=Math.sin(ph*Math.PI*2*(1+g*pos*0.4))/6;}s.push(v);}}
    else if(eng==='karplus'){s=[];const dam=pos;
      let y2=Math.random(); for(let x=0;x<160;x++){y2=(y2+Math.sin(x/160*Math.PI*8*(1-dam*0.5)))/2*(0.998-dam*0.06);s.push(y2);}}
    else if(eng==='guitar'){s=[];let y3=1;for(let x=0;x<160;x++){
      const decay=Math.exp(-x/120);y3=Math.sin(x/160*Math.PI*6*(1+pos))*decay+Math.sin(x/160*Math.PI*12*(1+pos))*decay*0.4*pos;s.push(y3);}}
    else if(eng==='organ'){s=[];const nd=Math.max(1,Math.round(1+pos*8));
      for(let x=0;x<160;x++){let v=0;for(let k=0;k<nd;k++){const r=[1,2,3,4,5,6,8,10,16][k];v+=Math.sin(x/160*Math.PI*2*r)/nd;}s.push(v);}}
    else if(eng==='chip'){s=[];for(let x=0;x<160;x++){const ph=x/160;const sq=(ph%0.5<0.25?1:-1);const oct=(ph*2%1<0.5?0.3:-0.3);s.push((sq+oct)/1.3);}}
    else if(eng==='noise'){s=[];for(let x=0;x<160;x++)s.push((Math.random()*2-1)*(0.3+pos*0.7));}
    else if(eng==='fold'){s=[];for(let x=0;x<160;x++){const xv=Math.sin(x/160*Math.PI*2)*(1+pos*8);s.push(Math.sin(xv*Math.PI*(1+pos*3)));}}
    else if(eng==='reese'){s=[];for(let x=0;x<160;x++){const d=8+pos*30;const a=((x/160*(1+d/100))%1)*2-1;const b2=((x/160*(1-d/100))%1)*2-1;s.push((a+b2)/2);}}
    else if(eng==='ring'){s=[];const ratio=0.5+pos*3.2;
      for(let x=0;x<160;x++){const ph=x/160*Math.PI*2;s.push(Math.sin(ph)*Math.sin(ph*ratio));}}
    else if(eng==='sync'){s=[];const wrap=1+pos*2;
      for(let x=0;x<160;x++){const saw=((x/160*wrap)%1)*2-1;s.push(saw*0.75+((x/160)%1*2-1)*0.25);}}
    else if(eng==='bell'){s=[];const ratio=3.5+pos*3.5;
      for(let x=0;x<160;x++){const ph=x/160*Math.PI*2;
        s.push(Math.sin(ph+Math.sin(ph*ratio)*1.4)*0.8+Math.sin(ph*2.99)*0.18);}}
    else if(eng==='strings'){s=[];for(let x=0;x<160;x++){let v=0;
      for(let j=0;j<3;j++){const d=(j-1)*(0.02+pos*0.05);v+=(((x/160)*(1+d))%1)*2-1;}s.push(v/3*0.8);}}
    else if(eng==='flute'){s=[];for(let x=0;x<160;x++){const ph=x/160*Math.PI*2;
      s.push(Math.sin(ph)*0.85+(Math.random()*2-1)*(0.05+pos*0.25));}}
    else if(eng==='vocal'){const im=new Float32Array(NH+1);
      const forms=vowelFormants(pos);
      for(let n=1;n<=NH;n++){let a=1/n;forms.forEach((ff,k)=>{const fn=ff/110;
        a+=[1,.7,.4][k]*Math.exp(-Math.pow((n-fn)/3,2));});im[n]=a/n;}
      s=waveSamples(im,160);}
    else {const im=new Float32Array(NH+1);const bright=clamp(pos,0,1);
      for(let n=1;n<=24;n++)im[n]=Math.pow(n,-(1.8-bright*1.4))*(n%2?1:.6);
      s=waveSamples(im,160);}
    let mx=0;for(const v of s)mx=Math.max(mx,Math.abs(v));if(mx>0)s=s.map(v=>v/mx);
    g.beginPath();
    for(let x=0;x<s.length;x++){const px=14+x/(s.length-1)*(W-28),py=H/2-s[x]*(H/2-18);
      x?g.lineTo(px,py):g.moveTo(px,py);}
    g.strokeStyle=accent;g.lineWidth=2;g.shadowColor=accent;g.shadowBlur=8;g.stroke();g.shadowBlur=0;
    g.fillStyle='rgba(124,132,151,.85)';g.font='9px JetBrains Mono';
    const vlabel=eng==='vocal'?'VOCAL '+['A','E','I','O','U'][Math.round(pos*4)]:({fm:'FM',analog:'ANALOG',additive:'ADDITIVE',pulse:'PULSE',supersaw:'SUPERSAW',granular:'GRANULAR',karplus:'PLUCK',guitar:'GUITAR',organ:'ORGAN',chip:'CHIP',noise:'NOISE',fold:'WAVEFOLD',reese:'REESE',ring:'RING MOD',sync:'SYNC',bell:'BELL',strings:'STRINGS',flute:'FLUTE'}[eng]);
    g.fillText(vlabel,8,12);
    return;
  }

  const FR=9;
  const cur=Math.round(pos*(FR-1));
  for(let f=FR-1;f>=0;f--){
    const fp=f/(FR-1);
    const im=morphTable(fp), s=waveSamples(im,120);
    const depth=(FR-1-f)/(FR-1);
    const ox=14+depth*26, oy=H-16-depth*(H-46);
    const w=W-60, amp=14;
    g.beginPath();
    for(let x=0;x<s.length;x++){
      const px=ox+x/(s.length-1)*w, py=oy-s[x]*amp;
      x?g.lineTo(px,py):g.moveTo(px,py);
    }
    if(f===cur){g.strokeStyle=accent;g.lineWidth=2;g.shadowColor=accent;g.shadowBlur=8;}
    else{g.strokeStyle='rgba(124,132,151,'+(.12+.2*(1-Math.abs(f-cur)/FR))+')';g.lineWidth=1;g.shadowBlur=0;}
    g.stroke();g.shadowBlur=0;
  }
  g.fillStyle='rgba(124,132,151,.8)';g.font='9px JetBrains Mono';
  g.fillText('POS '+Math.round(pos*100)+'%',8,12);
}
