/* ---------------- Web MIDI ---------------- */
function setMidiDot(text,live){const d=$('#midiDot');if(!d)return;
  d.textContent=text;d.classList.toggle('live',!!live);}
function handleMidi(msg){
  const [status,note,vel]=msg.data, cmd=status&0xf0;
  if(cmd===0x90&&vel>0){ensureAudio();noteOn(note,vel/127);}
  else if(cmd===0x80||(cmd===0x90&&vel===0)){noteOff(note);}
  else if(cmd===0xb0&&note===123){allOff();}            // all-notes-off
  else if(cmd===0xb0&&note===1){                         // mod wheel → filter cutoff
    if(AC){const v=vel/127;const cut=clamp(200*Math.pow(90,v),20,18000);
      P.f.cut=cut;voices.forEach(x=>{try{x.flt.frequency.setTargetAtTime(cut,AC.currentTime,.02);}catch(_){}});
      K.cut&&K.cut.set(cut,false);}
  }
  else if(cmd===0xe0){                                   // pitch bend → detune all voices ±2 semitones
    if(AC){const bend=((vel<<7)|note)-8192;const cents=(bend/8192)*200;
      voices.forEach(x=>{['a','b'].forEach(w=>x.oscs[w]&&x.oscs[w].forEach(o=>{try{o.detune.setTargetAtTime(cents,AC.currentTime,.01);}catch(_){}}));});}
  }
}
if(navigator.requestMIDIAccess){
  navigator.requestMIDIAccess().then(acc=>{
    const bind=()=>{let n=0;acc.inputs.forEach(inp=>{inp.onmidimessage=handleMidi;n++;});
      setMidiDot(n?('MIDI · '+n+' device'+(n>1?'s':'')):'MIDI ready',n>0);};
    bind();acc.onstatechange=bind;
  }).catch(()=>setMidiDot('MIDI blocked',false));
}else setMidiDot('MIDI n/a',false);

