  constructor(parent,{label,min,max,val,log=false,fmt=v=>v.toFixed(2),step=0,onchange,autoId}){
    Object.assign(this,{min,max,log,fmt,step,onchange,val,autoId});
    const el=document.createElement('div');el.className='knob';
    el.innerHTML=`<svg viewBox="0 0 46 46">
      <path class="arc-bg" d=""></path><path class="arc-val" d=""></path>
      <circle class="cap" cx="23" cy="23" r="12"></circle>
      <line class="ptr" x1="23" y1="23" x2="23" y2="12"></line>
    </svg><label>${label}</label><output></output>`;
    parent.appendChild(el);
    this.el=el;this.bg=el.querySelector('.arc-bg');this.fg=el.querySelector('.arc-val');
    this.ptr=el.querySelector('.ptr');this.out=el.querySelector('output');
    this.bg.setAttribute('d',this.arc(0,1));
    this.def=val;this.set(val,false);
    if(this.autoId)AUTOM.knobs[this.autoId]=this;     // register for automation playback
    let sy=0,sv=0;
    el.addEventListener('pointerdown',e=>{
      el.setPointerCapture(e.pointerId);sy=e.clientY;sv=this.norm();
      const mv=ev=>{const fine=ev.shiftKey?.25:1;
        this.setNorm(sv+(sy-ev.clientY)/140*fine);};
      const up=()=>{el.removeEventListener('pointermove',mv);el.removeEventListener('pointerup',up);};
      el.addEventListener('pointermove',mv);el.addEventListener('pointerup',up);
      e.preventDefault();});
    el.addEventListener('dblclick',()=>this.set(this.def));
    el.addEventListener('wheel',e=>{e.preventDefault();this.setNorm(this.norm()-Math.sign(e.deltaY)*.04);},{passive:false});
  }
  norm(){return this.log
    ? Math.log(this.val/this.min)/Math.log(this.max/this.min)
    : (this.val-this.min)/(this.max-this.min);}
  setNorm(n){n=clamp(n,0,1);
    let v=this.log? this.min*Math.pow(this.max/this.min,n) : this.min+n*(this.max-this.min);
    if(this.step)v=Math.round(v/this.step)*this.step;
    this.set(v);}
  set(v,fire=true){this.val=clamp(v,this.min,this.max);this.draw();
    this.out.textContent=this.fmt(this.val);
    if(fire&&this.onchange)this.onchange(this.val);
    if(fire&&this.autoId&&typeof autoCapture==='function')autoCapture(this.autoId,this.val);}
  arc(a,b){const s=-135+a*270,e=-135+b*270,r=19,cx=23,cy=23;
    const p=t=>[cx+r*Math.sin(t*Math.PI/180),cy-r*Math.cos(t*Math.PI/180)];
    const[x1,y1]=p(s),[x2,y2]=p(e);
    return `M ${x1} ${y1} A ${r} ${r} 0 ${(e-s)>180?1:0} 1 ${x2} ${y2}`;}
  draw(){const n=this.norm();
    this.fg.setAttribute('d',n>0.005?this.arc(0,n):'M 0 0');
    const ang=-135+n*270;
    this.ptr.setAttribute('transform',`rotate(${ang} 23 23)`);}
}

