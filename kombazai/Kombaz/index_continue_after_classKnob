let pointerNote=null;
function keyVel(el,e){
  /* lower on the key = louder (like real velocity); default mid if unknown */
  try{const r=el.getBoundingClientRect();const y=(e.clientY-r.top)/r.height;
    return clamp(0.45+y*0.55,0.3,1);}catch(_){return 0.8;}
}
function bindKey(el,i){
  el.addEventListener('pointerdown',e=>{e.preventDefault();ensureAudio();
    pointerNote=BASE()+i;noteOn(pointerNote,keyVel(el,e));});
  el.addEventListener('pointerenter',e=>{if(e.buttons){const n=BASE()+i;
    if(pointerNote!==null&&pointerNote!==n)noteOff(pointerNote);
    pointerNote=n;noteOn(n,keyVel(el,e));}});
}
