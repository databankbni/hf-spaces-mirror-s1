/* ---- Randomize ---- */
function rnd(a,b){return a+Math.random()*(b-a);}
function pick(arr){return arr[Math.floor(Math.random()*arr.length)];}
$('#rndBtn').onclick=()=>{
  if(typeof pushUndo==='function')pushUndo();
  /* 🎲 randomizes the SOUND + MELODY only.
     It never touches the Rhythm Engine pattern or the Master volume. */
  const keepVol=P.m.vol;
  const engines=['wt','fm','analog','additive','vocal','pulse','supersaw','granular','karplus','guitar','organ','chip','fold','reese','ring','sync','bell','strings','flute'];
  for(const w of ['a','b']){const c=P[w];
    c.eng=pick(engines);c.pos=rnd(0,1);c.oct=Math.round(rnd(-2,2));
    c.det=rnd(0,40);c.uni=1+Math.floor(rnd(0,6));c.lvl=w==='a'?rnd(.6,.9):rnd(.2,.6);
    c.fm=rnd(0,.6);c.fmRatio=pick([1,2,3,3.5,4,5,7]);}
  P.f.type=pick(['lowpass','highpass','bandpass']);P.f.cut=rnd(300,9000);P.f.res=rnd(1,12);P.f.env=rnd(-2,3);
  P.e1.a=rnd(.002,.4);P.e1.d=rnd(.1,1);P.e1.s=rnd(.2,.9);P.e1.r=rnd(.1,1.5);
  P.x.verb=rnd(.1,.6);P.x.dmix=rnd(0,.4);P.x.chor=rnd(0,.5);
  P.l.target=pick(['cutoff','pitch','wt']);P.l.rate=rnd(.2,8);P.l.amt=rnd(0,.4);
  P.m.vol=keepVol;                       // master volume untouched
  syncAllKnobs();
