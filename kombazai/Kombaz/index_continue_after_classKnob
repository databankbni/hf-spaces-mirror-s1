   ===================================================================== */
let liveRecorder=null, liveChunks=[], liveRecording=false, lastLiveRec=null;
$('#liveRecBtn').onclick=()=>{
  ensureAudio();
  if(!master.recDest){alert('Live recording not available in this browser.');return;}
  if(!liveRecording){
    liveChunks=[];
    let mime='audio/webm';
    if(MediaRecorder.isTypeSupported('audio/webm;codecs=opus'))mime='audio/webm;codecs=opus';
    else if(MediaRecorder.isTypeSupported('audio/ogg;codecs=opus'))mime='audio/ogg;codecs=opus';
    else if(MediaRecorder.isTypeSupported('audio/mp4'))mime='audio/mp4';
    try{liveRecorder=new MediaRecorder(master.recDest.stream,{mimeType:mime});}
    catch(e){liveRecorder=new MediaRecorder(master.recDest.stream);}
    liveRecorder.ondataavailable=e=>{if(e.data.size>0)liveChunks.push(e.data);};
    liveRecorder.onstop=async()=>{
      $('#liveRecBtn').textContent='⏳ WAV…';
      try{
        const blob=new Blob(liveChunks,{type:liveChunks[0]?.type||'audio/webm'});
        const arrayBuf=await blob.arrayBuffer();
        const decoded=await AC.decodeAudioData(arrayBuf);
        const wavBlob=new Blob([audioBufferToWav(decoded)],{type:'audio/wav'});
        const a=document.createElement('a');a.href=URL.createObjectURL(wavBlob);
        a.download='kombaz-live-'+Date.now()+'.wav';a.click();
        lastLiveRec={blob:wavBlob};
        setTimeout(()=>URL.revokeObjectURL(a.href),15000);
      }catch(err){
        /* fallback: download the compressed file if WAV conversion fails */
        const blob=new Blob(liveChunks,{type:liveChunks[0]?.type||'audio/webm'});
        const a=document.createElement('a');a.href=URL.createObjectURL(blob);
        a.download='kombaz-live-'+Date.now()+'.webm';a.click();
      }
      $('#liveRecBtn').textContent='⏺ LIVE REC';$('#liveRecBtn').classList.remove('rec-active');
    };
    liveRecorder.start();
    liveRecording=true;
    $('#liveRecBtn').textContent='⏹ STOP REC';$('#liveRecBtn').classList.add('rec-active');
  }else{
    liveRecorder.stop();liveRecording=false;
  }
};

