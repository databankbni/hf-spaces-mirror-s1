const DEFAULT=JSON.parse(JSON.stringify(P));
function applyPreset(name){
  allOff();
  const base=JSON.parse(JSON.stringify(DEFAULT)), p=PRESETS[name]||{};
  for(const sec in p)Object.assign(base[sec],p[sec]);
  base.octShift=P.octShift;
  for(const sec in base)Object.assign(P[sec]??(P[sec]={}),base[sec]);
  Object.assign(P,{octShift:base.octShift});
  /* refresh UI */
  for(const w of ['a','b']){['pos','oct','det','uni','lvl','pan','fm','fmr'].forEach(k=>{const kk=k==='fmr'?'fmRatio':k;K[w+k]&&K[w+k].set(P[w][kk],false);});setEngine(w,P[w].eng||'wt');}
  K.cut.set(P.f.cut,false);K.res.set(P.f.res,false);K.env.set(P.f.env,false);K.drv.set(P.f.drv,false);
  K.lrate.set(P.l.rate,false);K.lamt.set(P.l.amt,false);
  K.chor.set(P.x.chor,false);K.dtime.set(P.x.dtime,false);K.dfb.set(P.x.dfb,false);
  K.dmix.set(P.x.dmix,false);K.verb.set(P.x.verb,false);K.vol.set(P.m.vol,false);
  K.subLvl&&K.subLvl.set(P.sub.lvl,false);K.subOct&&K.subOct.set(P.sub.oct,false);
  document.querySelectorAll('#subwave button').forEach(b=>b.classList.toggle('on',b.dataset.v===P.sub.wave));
  ['crush','phaser','eqLow','eqHi','widen','comp'].forEach(k=>K[k]&&K[k].set(P.x[k],false));
  K.fxDrive&&K.fxDrive.set(P.x.dist,false);K.flanger&&K.flanger.set(P.x.flanger||0,false);
  K.trem&&K.trem.set(P.x.trem||0,false);K.tremRate&&K.tremRate.set(P.x.tremRate||5,false);
  K.autopan&&K.autopan.set(P.x.autopan||0,false);K.gate&&K.gate.set(P.x.gate||0,false);
  applyFX();
  refreshADSR();
  [['#ftype',P.f.type],['#lshape',P.l.shape],['#ltarget',P.l.target]].forEach(([sel,val])=>{
    document.querySelectorAll(sel+' button').forEach(b=>b.classList.toggle('on',b.dataset.v===val));});
  rebuildWave('a');rebuildWave('b');drawWT('a');drawWT('b');
  if(AC){
    master.sh.curve=driveCurve(P.x.dist);
    master.chWet.gain.value=P.x.chor;master.dl.delayTime.value=P.x.dtime;
    master.fb.gain.value=P.x.dfb;master.dWet.gain.value=P.x.dmix;master.vWet.gain.value=P.x.verb;
    master.bus.gain.value=P.m.vol;
    lfo.osc.type=P.l.shape;lfo.osc.frequency.value=P.l.rate;applyLfoAmt();
    if(lfo2.osc){lfo2.osc.type=P.l2.shape;lfo2.osc.frequency.value=P.l2.rate;applyLfo2Amt();}
  }
}
