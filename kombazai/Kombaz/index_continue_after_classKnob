/* =====================================================================
   piano roll — visual editor for the recorded riff
   ===================================================================== */
function rollNotes(){
  const L=loopLen()||2, grid=L/ROLL.cols;
  const evs=quantizeEvents(REC.events).map(e=>({...e,t:((e.t%L)+L)%L}));
  const open={},notes=[];
  for(const e of evs){
    if(e.type==='on')open[e.midi]={t:e.t,vel:e.vel==null?0.8:e.vel};
    else if(open[e.midi]!=null){const o=open[e.midi];notes.push({midi:e.midi,start:o.t,vel:o.vel,dur:Math.max(grid,e.t-o.t)});delete open[e.midi];}
  }
  for(const m in open)notes.push({midi:+m,start:open[m].t,vel:open[m].vel,dur:grid});
  return notes;
}
const ROLL={open:false,lo:48,hi:72,cols:16,snap:16,erase:false}; // cols=zoom, snap=quantize grid

/* ---- Piano Roll riff banks A/B/C/D ----
   The active riff always lives in REC.events (so recording, export, save all
   keep working). Switching banks stores the current buffer and loads another. */
const RIFFB={bank:'A',follow:true,banks:{A:[],B:[],C:[],D:[]}};
RIFFB.banks.A=REC.events;   // bank A is the initial live buffer
function riffSetBank(name){
  if(RIFFB.banks[name]===undefined||name===RIFFB.bank){riffPaintTabs();return;}
  /* stash current buffer into its bank, then activate the new one */
  RIFFB.banks[RIFFB.bank]=REC.events;
  RIFFB.bank=name;
  REC.events=RIFFB.banks[name];
  riffPaintTabs();
  recInfo();if(ROLL.open)drawRoll();
  if(TR.mode==='track')rescheduleRiff();
}
function riffPaintTabs(){
  document.querySelectorAll('#riffBankTabs button[data-b]').forEach(b=>b.classList.toggle('on',b.dataset.b===RIFFB.bank));
}
function rollSnap(t){const L=loopLen()||2;if(!ROLL.snap)return t;const g=L/ROLL.snap;return Math.round(t/g)*g;}
function rollSnapDur(d){const L=loopLen()||2;if(!ROLL.snap)return Math.max(0.03,d);const g=L/ROLL.snap;return Math.max(g,Math.round(d/g)*g);}

function drawRollKeys(){
  const c=$('#rollKeys');if(!c||!ROLL.open)return;
  const rows=ROLL.hi-ROLL.lo, rh=c.height/rows;
  const g=c.getContext('2d');g.clearRect(0,0,c.width,c.height);
  for(let r=0;r<rows;r++){
    const midi=ROLL.hi-1-r;
    const black=[1,3,6,8,10].includes(midi%12);
    g.fillStyle=black?'#1c2030':'#2a3040';g.fillRect(0,r*rh,c.width,rh);
    g.strokeStyle='#111';g.strokeRect(0,r*rh,c.width,rh);
    if(midi%12===0){// C notes get a label
      g.fillStyle='#2ee6ff';g.font=`bold ${Math.max(8,rh*.55)}px JetBrains Mono`;
      g.textAlign='right';g.fillText('C'+Math.floor(midi/12-1),c.width-2,r*rh+rh*.75);
    }else if(!black){
      g.fillStyle='rgba(200,210,230,.5)';g.font=`${Math.max(7,rh*.45)}px JetBrains Mono`;
      g.textAlign='right';g.fillText(NOTE_NAMES[midi%12],c.width-2,r*rh+rh*.75);
    }
  }
}
function drawRoll(){
  const c=$('#roll');if(!c||!ROLL.open)return;
  const [g,W,H]=setupCanvas(c);
  const rows=ROLL.hi-ROLL.lo, rh=H/rows, cw=W/ROLL.cols;
  g.clearRect(0,0,W,H);
  // Row backgrounds
  for(let r=0;r<rows;r++){
    const midi=ROLL.hi-1-r;
    const black=[1,3,6,8,10].includes(midi%12);
    g.fillStyle=black?'rgba(0,0,0,.35)':'rgba(255,255,255,.04)';g.fillRect(0,r*rh,W,rh);
    if(midi%12===0){g.strokeStyle='rgba(46,230,255,.18)';g.lineWidth=1;g.beginPath();g.moveTo(0,r*rh);g.lineTo(W,r*rh);g.stroke();}
  }
  // Vertical grid
  for(let i=0;i<=ROLL.cols;i++){g.beginPath();g.moveTo(i*cw,0);g.lineTo(i*cw,H);
    g.strokeStyle=i%4===0?'rgba(124,132,151,.3)':'rgba(124,132,151,.1)';g.lineWidth=i%4===0?1.2:0.7;g.stroke();}
  // Step beat shading
  for(let i=0;i<ROLL.cols;i+=4){g.fillStyle='rgba(46,230,255,.025)';g.fillRect(i*cw,0,cw,H);}
  const L=loopLen()||2;
  // Notes
  rollNotes().forEach(n=>{
    if(n.midi<ROLL.lo||n.midi>=ROLL.hi)return;
    const x=(n.start/L)*W+1, noteW=Math.max(cw-3,(n.dur/L)*W-3), y=(ROLL.hi-1-n.midi)*rh+1;
    const h=rh-2, a=0.4+(n.vel||0.8)*0.6;
    // Note body
    g.fillStyle=`rgba(46,230,255,${a})`;g.shadowColor='#2ee6ff';g.shadowBlur=5;
    const rad=3;g.beginPath();g.roundRect?g.roundRect(x,y,noteW,h,rad):g.rect(x,y,noteW,h);g.fill();g.shadowBlur=0;
    // Note name
    if(noteW>20&&rh>10){
      g.fillStyle='rgba(0,20,30,.85)';g.font=`bold ${Math.min(10,rh*.65)}px JetBrains Mono`;
      g.textAlign='left';g.fillText(NOTE_NAMES[n.midi%12],x+3,y+h*.75);
    }
    // Resize handle
    g.fillStyle='rgba(255,255,255,.35)';g.fillRect(x+noteW-5,y+1,4,h-2);
  });
  // Playhead
  if(TR.mode){const ph=((TR.nextStep-TR.loopStart)/L)*W;
    g.strokeStyle='rgba(125,255,168,.6)';g.lineWidth=2;g.beginPath();g.moveTo(ph,0);g.lineTo(ph,H);g.stroke();}
}
/* Piano Roll — supports click-to-add/remove, drag-to-move, right-edge-drag-to-resize */
const RDRAG={active:false,note:null,mode:null,startX:0,startT:0,origStart:0,origDur:0};
function rollHitTest(x,y,W,H){
  const L=loopLen()||2;
  const rows=ROLL.hi-ROLL.lo,rh=H/rows;
  const midi=ROLL.hi-1-Math.floor(y*rows);
  const t=(x/W)*L;
  const notes=rollNotes().filter(n=>n.midi===midi);
  for(const n of notes){
    if(t>=n.start-1e-4&&t<n.start+n.dur-1e-4){
      const nx=(n.start/L)*W, nw=Math.max(8,(n.dur/L)*W-2);
      const isResize=(x/W)*W>nx+nw-10;  // within 10px of right edge
      return {note:n,mode:isResize?'resize':'move'};
    }
  }
  return null;
}
function rollPointerDown(ev){
  const c=$('#roll');const rect=c.getBoundingClientRect();
  const x=(ev.clientX-rect.left), y=(ev.clientY-rect.top);
  const xn=x/rect.width, yn=y/rect.height;
  const L=loopLen()||2, grid=L/ROLL.cols;
  /* ERASE mode: delete any note under pointer and continue deleting on drag */
  if(ROLL.erase||ev.button===2){
    ev.preventDefault();try{c.setPointerCapture(ev.pointerId);}catch(_){}
    RDRAG.active=true;RDRAG.mode='erase';RDRAG.startX=x;
    const hit=rollHitTest(x,y,rect.width,rect.height);
    if(hit){
      if(typeof pushUndo==='function')pushUndo();
      const n=hit.note;
      REC.events=REC.events.filter(e=>!(e.midi===n.midi&&Math.abs(((e.t%(L||2)+L)%L||0)-n.start)<grid*0.6));
      recInfo();drawRoll();if(typeof saveState==='function')saveState();
    }
    return;
  }
  const hit=rollHitTest(x,y,rect.width,rect.height);
  if(hit){
    ev.preventDefault();try{c.setPointerCapture(ev.pointerId);}catch(_){}
    if(typeof pushUndo==='function')pushUndo();
    RDRAG.active=true;RDRAG.note=hit.note;RDRAG.mode=hit.mode;
    RDRAG.startX=x;RDRAG.startY=y;RDRAG.moved=false;RDRAG.dragArmed=(hit.mode==='resize');
    RDRAG.origStart=hit.note.start;RDRAG.origDur=hit.note.dur;
    c.style.cursor=hit.mode==='resize'?'ew-resize':'pointer';
    /* long-press (350ms) on a note arms drag-to-move (touch-friendly).
       a quick tap without long-press = delete (handled in pointerup). */
    if(hit.mode==='move'){
      clearTimeout(RDRAG.holdTimer);
      RDRAG.holdTimer=setTimeout(()=>{
        RDRAG.dragArmed=true;c.style.cursor='grabbing';
        if(navigator.vibrate)try{navigator.vibrate(15);}catch(_){}
        /* subtle visual cue */
        c.style.outline='2px solid var(--cyA)';setTimeout(()=>c.style.outline='',250);
      },350);
    }
  }else{
    /* click on empty = add note (snapped to the snap resolution) */
    const midi=ROLL.hi-1-Math.floor(yn*(ROLL.hi-ROLL.lo));
    const t=rollSnap(xn*L);
    const dur=ROLL.snap?(L/ROLL.snap):(L/ROLL.cols);
    if(midi<ROLL.lo||midi>=ROLL.hi)return;
    if(typeof pushUndo==='function')pushUndo();
    REC.events.push({t,type:'on',midi,vel:0.8});
    REC.events.push({t:t+dur*0.9,type:'off',midi});
    REC.events.sort((a,b)=>a.t-b.t);
    recInfo();drawRoll();if(typeof saveState==='function')saveState();
    if(TR.mode==='track')rescheduleRiff();
  }
}
function rollPointerMove(ev){
  if(!RDRAG.active)return;
  /* erase mode: delete notes as pointer moves */
  if(RDRAG.mode==='erase'){
    const c=$('#roll');const rect=c.getBoundingClientRect();
    const x=(ev.clientX-rect.left),y=(ev.clientY-rect.top);
    const hit=rollHitTest(x,y,rect.width,rect.height);
    if(hit){const L=loopLen()||2,grid=L/ROLL.cols,n=hit.note;
      REC.events=REC.events.filter(e=>!(e.midi===n.midi&&Math.abs(((e.t%(L||2)+L)%L||0)-n.start)<grid*0.6));
      recInfo();drawRoll();}
    return;
  }
  const c=$('#roll');const rect=c.getBoundingClientRect();
  const dx=(ev.clientX-rect.left)-RDRAG.startX;
  const dy=(ev.clientY-rect.top)-(RDRAG.startY||0);
  if(Math.abs(dx)>4||Math.abs(dy)>4){RDRAG.moved=true;
    /* if the user starts dragging significantly before long-press fires,
       cancel the pending timer; small finger jitter won't trigger a move */
    if(!RDRAG.dragArmed&&(Math.abs(dx)>14||Math.abs(dy)>14)){RDRAG.dragArmed=true;clearTimeout(RDRAG.holdTimer);}
  }
  /* don't move until drag is armed (long-press) — keeps taps clean on touch */
  if(RDRAG.mode==='move'&&!RDRAG.dragArmed)return;
  const L=loopLen()||2, grid=L/ROLL.cols;
  const dt=(dx/rect.width)*L;
  const n=RDRAG.note;
  if(!n)return;
  /* remove and re-add the note with new values */
  REC.events=REC.events.filter(e=>!(e.midi===n.midi&&Math.abs(((e.t%(L||2)+L)%L||0)-n.start)<grid*0.6));
  let newStart=n.start, newDur=n.dur;
  if(RDRAG.mode==='move'){newStart=clamp(RDRAG.origStart+dt,0,L);}
  else if(RDRAG.mode==='resize'){newDur=Math.max(0.03,RDRAG.origDur+dt);}
  newStart=rollSnap(newStart);
  newDur=rollSnapDur(newDur);
  REC.events.push({t:newStart,type:'on',midi:n.midi,vel:n.vel||0.8});
  REC.events.push({t:newStart+newDur*0.95,type:'off',midi:n.midi});
  REC.events.sort((a,b)=>a.t-b.t);
  drawRoll();
}
function rollPointerUp(ev){
  if(!RDRAG.active)return;
  clearTimeout(RDRAG.holdTimer);
  const wasErase=RDRAG.mode==='erase';
  const wasMove=RDRAG.mode==='move';
  const moved=RDRAG.moved&&RDRAG.dragArmed;
  const note=RDRAG.note;
  RDRAG.active=false;RDRAG.note=null;RDRAG.mode=null;RDRAG.moved=false;RDRAG.dragArmed=false;
  const c=$('#roll');c.style.cursor=ROLL.erase?'cell':'crosshair';
  /* a quick tap (no real drag) on an existing note = delete it */
  if(wasMove&&!moved&&note){
    const L=loopLen()||2,grid=L/ROLL.cols;
    REC.events=REC.events.filter(e=>!(e.midi===note.midi&&Math.abs(((e.t%(L||2)+L)%L||0)-note.start)<grid*0.6));
    recInfo();drawRoll();if(typeof saveState==='function')saveState();
    if(TR.mode==='track')rescheduleRiff();
    return;
  }
  if(!wasErase){recInfo();if(typeof saveState==='function')saveState();
    if(TR.mode==='track')rescheduleRiff();}
}
/* right-click = delete note */
function rollContextMenu(ev){
  ev.preventDefault();
  const c=$('#roll');const rect=c.getBoundingClientRect();
  const x=(ev.clientX-rect.left),y=(ev.clientY-rect.top);
  const L=loopLen()||2, grid=L/ROLL.cols;
  const hit=rollHitTest(x,y,rect.width,rect.height);
  if(!hit)return;
  if(typeof pushUndo==='function')pushUndo();
  const n=hit.note;
  REC.events=REC.events.filter(e=>!(e.midi===n.midi&&Math.abs(((e.t%(L||2)+L)%L||0)-n.start)<grid*0.6));
  recInfo();drawRoll();if(typeof saveState==='function')saveState();
  if(TR.mode==='track')rescheduleRiff();
}
