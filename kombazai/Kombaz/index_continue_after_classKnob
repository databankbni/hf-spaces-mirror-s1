/* =====================================================================
   PANEL LAYOUT — drag to reorder + collapse/hide, to fit your workflow.
   The KOMBAZ SYNTH header stays fixed. Layout persists in localStorage.
   ===================================================================== */
(function panelLayout(){
  const grid=$('#grid');if(!grid)return;
  const LAYOUT_KEY='kombaz_layout';
  const panels=[...grid.querySelectorAll('.panel')];
  panels.forEach((p,i)=>{
    if(!p.dataset.pid){const cls=[...p.classList].find(c=>c!=='panel')||('panel'+i);p.dataset.pid=cls;}
    const h=p.querySelector('h2');if(!h||h.querySelector('.panel-ctrls'))return;
    const ctrls=document.createElement('span');ctrls.className='panel-ctrls';
    ctrls.innerHTML=`<button class="pc-up" title="Move up">▲</button><button class="pc-down" title="Move down">▼</button><button class="pc-grip" title="Drag to reorder">⋮⋮</button><button class="pc-min" title="Collapse / expand">▾</button>`;
    h.appendChild(ctrls);
    const body=document.createElement('div');body.className='panel-body';
    let n=h.nextSibling;const frag=document.createDocumentFragment();
    while(n){const next=n.nextSibling;frag.appendChild(n);n=next;}
    body.appendChild(frag);p.appendChild(body);
    /* collapse toggle */
    ctrls.querySelector('.pc-min').addEventListener('click',e=>{e.stopPropagation();
      const col=p.classList.toggle('collapsed');
      ctrls.querySelector('.pc-min').textContent=col?'▸':'▾';saveLayout();});
    /* move up / down buttons — reliable on every device */
    ctrls.querySelector('.pc-up').addEventListener('click',e=>{e.stopPropagation();
      const vis=visiblePanels();const i2=vis.indexOf(p);
      if(i2>0){grid.insertBefore(p,vis[i2-1]);saveLayout();
        p.scrollIntoView({block:'nearest',behavior:'smooth'});}});
    ctrls.querySelector('.pc-down').addEventListener('click',e=>{e.stopPropagation();
      const vis=visiblePanels();const i2=vis.indexOf(p);
      if(i2<vis.length-1){grid.insertBefore(vis[i2+1],p);saveLayout();
        p.scrollIntoView({block:'nearest',behavior:'smooth'});}});
    /* drag to reorder via the grip — robust version */
    const grip=ctrls.querySelector('.pc-grip');
    let dragging=false;
    grip.addEventListener('pointerdown',e=>{
      e.preventDefault();e.stopPropagation();
      dragging=true;p.classList.add('dragging');
      try{grip.setPointerCapture(e.pointerId);}catch(_){}
      const move=ev=>{
        if(!dragging)return;
        /* hide the dragged panel from hit-testing so we find the panel underneath */
        const prevPE=p.style.pointerEvents;p.style.pointerEvents='none';
        const el=document.elementFromPoint(ev.clientX,ev.clientY);
        p.style.pointerEvents=prevPE;
        const tgt=el&&el.closest('.panel');
        if(tgt&&tgt!==p&&tgt.parentNode===grid){
          const rect=tgt.getBoundingClientRect();
          const after=(ev.clientY-rect.top)>rect.height/2;
          grid.insertBefore(p,after?tgt.nextSibling:tgt);
        }
      };
      const up=()=>{dragging=false;p.classList.remove('dragging');
        grip.removeEventListener('pointermove',move);
        grip.removeEventListener('pointerup',up);
        grip.removeEventListener('pointercancel',up);
        saveLayout();};
      grip.addEventListener('pointermove',move);
      grip.addEventListener('pointerup',up);
      grip.addEventListener('pointercancel',up);
    });
  });
  function visiblePanels(){return [...grid.querySelectorAll('.panel:not(.user-hidden)')];}
  function saveLayout(){
    const order=[...grid.querySelectorAll('.panel')].map(p=>p.dataset.pid);
    const collapsed=[...grid.querySelectorAll('.panel.collapsed')].map(p=>p.dataset.pid);
    const hidden=[...grid.querySelectorAll('.panel.user-hidden')].map(p=>p.dataset.pid);
    try{localStorage.setItem(LAYOUT_KEY,JSON.stringify({order,collapsed,hidden}));}catch(e){}
  }
  function restoreLayout(){
    let s;try{s=JSON.parse(localStorage.getItem(LAYOUT_KEY)||'null');}catch(e){return;}
    if(!s)return;
    if(Array.isArray(s.order))s.order.forEach(pid=>{
      const p=grid.querySelector(`.panel[data-pid="${pid}"]`);if(p)grid.appendChild(p);});
    (s.collapsed||[]).forEach(pid=>{const p=grid.querySelector(`.panel[data-pid="${pid}"]`);
      if(p){p.classList.add('collapsed');const m=p.querySelector('.pc-min');if(m)m.textContent='▸';}});
    (s.hidden||[]).forEach(pid=>{const p=grid.querySelector(`.panel[data-pid="${pid}"]`);
      if(p)p.classList.add('user-hidden');});
    updatePanelMenu();
  }
  /* build a "panels" menu so hidden panels can be brought back; includes a close X */
  function updatePanelMenu(){
    const menu=$('#panelMenu');if(!menu)return;menu.innerHTML='';
    const head=document.createElement('div');head.className='panel-menu-head';
    head.innerHTML=`<span>PANELS</span><button class="panel-menu-x" title="Close">✕</button>`;
    head.querySelector('.panel-menu-x').addEventListener('click',()=>menu.classList.remove('show'));
    menu.appendChild(head);
    panels.forEach(p=>{
      const pid=p.dataset.pid;const name=(p.querySelector('h2')?.textContent||pid).replace(/[⋮▾▸▲▼].*/,'').trim();
      const row=document.createElement('label');row.className='panel-menu-row';
      const cb=document.createElement('input');cb.type='checkbox';cb.checked=!p.classList.contains('user-hidden');
      cb.addEventListener('change',()=>{p.classList.toggle('user-hidden',!cb.checked);saveLayout();});
      row.appendChild(cb);row.appendChild(document.createTextNode(' '+name));
      menu.appendChild(row);
    });
    /* show-all / reset row */
    const foot=document.createElement('div');foot.className='panel-menu-foot';
    foot.innerHTML=`<button class="pm-showall">SHOW ALL</button><button class="pm-reset">RESET LAYOUT</button>`;
    foot.querySelector('.pm-showall').addEventListener('click',()=>{
      panels.forEach(p=>p.classList.remove('user-hidden'));saveLayout();updatePanelMenu();});
    foot.querySelector('.pm-reset').addEventListener('click',()=>{
      try{localStorage.removeItem(LAYOUT_KEY);}catch(_){}
      location.reload();});
    menu.appendChild(foot);
  }
  const layoutBtn=$('#layoutBtn');
  if(layoutBtn){layoutBtn.addEventListener('click',()=>{
    const m=$('#panelMenu');if(m){m.classList.toggle('show');updatePanelMenu();}});}
  restoreLayout();updatePanelMenu();
})();

/* If manifest.webmanifest isn't served (single-file copy), inline one so the
   install prompt still appears. Uses the inline SVG icon. */
(async()=>{
  try{const r=await fetch('manifest.webmanifest',{method:'HEAD'});if(r.ok)return;}catch(e){}
  const icon='data:image/svg+xml;base64,'+btoa(
    `<svg xmlns="http://www.w3.org/2000/svg" width="512" height="512"><rect width="512" height="512" fill="#0d0f13"/><text x="256" y="340" font-family="Arial" font-size="300" font-weight="bold" fill="#2ee6ff" text-anchor="middle">K</text></svg>`);
  const man={name:'KOMBAZ Synth',short_name:'KOMBAZ',start_url:'.',scope:'.',display:'standalone',
    background_color:'#0d0f13',theme_color:'#0d0f13',
    icons:[{src:icon,sizes:'512x512',type:'image/svg+xml',purpose:'any maskable'}]};
  const url='data:application/manifest+json;base64,'+btoa(unescape(encodeURIComponent(JSON.stringify(man))));
  const link=document.getElementById('manifestLink');if(link)link.href=url;
})();
</script>
