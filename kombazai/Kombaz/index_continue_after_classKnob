let tapTimes=[];
$('#tapBtn').addEventListener('click',()=>{
  const now=performance.now();
  tapTimes=tapTimes.filter(t=>now-t<2500);   // reset if a tap is >2.5s old
  tapTimes.push(now);
  $('#tapBtn').classList.add('flash');setTimeout(()=>$('#tapBtn').classList.remove('flash'),100);
  if(tapTimes.length>=2){
    let sum=0;for(let i=1;i<tapTimes.length;i++)sum+=tapTimes[i]-tapTimes[i-1];
    const avg=sum/(tapTimes.length-1);
    const bpm=clamp(Math.round(60000/avg),60,200);
