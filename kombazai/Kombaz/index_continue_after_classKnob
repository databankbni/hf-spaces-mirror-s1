  if(SONG.pos>=SONG_COLS){SONG.pos=0;}
  let activePat=null;
  PAT_NAMES.forEach((p,pi)=>{if(SONG.cells[pi][SONG.pos])activePat=p;});
  if(activePat)switchPattern(activePat);
  songHighlight(SONG.pos);
  rescheduleRiff();
}
