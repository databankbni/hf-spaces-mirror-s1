}
function startClock(mode){
  ensureAudio();stopClock();
  TR.mode=mode;TR.step=0;TR.nextStep=AC.currentTime+.06;TR.loopStart=TR.nextStep;
  if(mode==='track'){DRUM.chainIdx=0;rescheduleRiff();updateChainHilite();}
  TR.schedTimer=setInterval(clockTick,25);
