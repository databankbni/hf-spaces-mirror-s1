/* in track mode we follow DRUM.chain; in beat mode we loop the active pattern */
function curChainGrid(){
  if(TR.mode!=='track'||!DRUM.chain.length)return DRUM.grid;
  const name=DRUM.chain[DRUM.chainIdx%DRUM.chain.length];
  return DRUM.patterns[name]||DRUM.grid;
}
function clockTick(){
  const ahead=AC.currentTime+0.1, cols=steps();
  while(TR.nextStep<ahead){
    const stepIdx=TR.step%cols;
    /* swing: delay odd 16th-notes by up to ~60% of a step */
    const sw=(stepIdx%2===1)?DRUM.swing*spb()*0.6:0;
    const when=TR.nextStep+sw;
    trigStep(stepIdx,when,curChainGrid());
    if(TR.mode==='track')fireRiffWindow(TR.nextStep,TR.nextStep+spb());
    /* melody sequencer — fires on every 16th step */
    if(MEL.on && MEL.steps[stepIdx%16].on){
      const ms=MEL.steps[stepIdx%16];
      const gate=when+spb()*0.85;
      setTimeout(()=>voiceOn(ms.note,ms.vel),Math.max(0,(when-AC.currentTime)*1000));
      setTimeout(()=>voiceOff(ms.note,true),Math.max(0,(gate-AC.currentTime)*1000));
    }
    if(MEL.on)setTimeout(()=>melHighlight(stepIdx%16),Math.max(0,(when-AC.currentTime)*1000));
    TR.step++;TR.nextStep+=spb();
    if(TR.step%cols===0){
      TR.loopStart+=loopLen();
      /* automation: replay captured knob moves for the upcoming loop */
      if(AUTOM.events.length&&!AUTOM.recording){
        const loopStartWall=performance.now()+(TR.loopStart-AC.currentTime)*1000;
        autoScheduleLoop(loopStartWall);
      }
      /* align the automation record clock to loop boundaries so capture wraps cleanly */
      if(AUTOM.recording){
        AUTOM.t0=performance.now()+(TR.loopStart-AC.currentTime)*1000;
      }
      if(TR.mode==='track'){
        if(SONG.running)songAdvance();
        else{DRUM.chainIdx++;rescheduleRiff();updateChainHilite();}
      }
    }
  }
}
function updateChainHilite(){
  if(!DRUM.chain.length)return;
