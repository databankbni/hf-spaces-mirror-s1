/* ---------- OFFLINE WAV RENDER (real, full quality) ---------- */
function audioBufferToWav(buf){
  const nCh=buf.numberOfChannels,len=buf.length,sr=buf.sampleRate;
  const out=new ArrayBuffer(44+len*nCh*2),view=new DataView(out);
  const wr=(o,s)=>{for(let i=0;i<s.length;i++)view.setUint8(o+i,s.charCodeAt(i));};
  wr(0,'RIFF');view.setUint32(4,36+len*nCh*2,true);wr(8,'WAVE');wr(12,'fmt ');
  view.setUint32(16,16,true);view.setUint16(20,1,true);view.setUint16(22,nCh,true);
  view.setUint32(24,sr,true);view.setUint32(28,sr*nCh*2,true);
  view.setUint16(32,nCh*2,true);view.setUint16(34,16,true);wr(36,'data');
  view.setUint32(40,len*nCh*2,true);
  let off=44;
  for(let i=0;i<len;i++)for(let c=0;c<nCh;c++){
    let s=Math.max(-1,Math.min(1,buf.getChannelData(c)[i]));
    view.setInt16(off,s<0?s*0x8000:s*0x7FFF,true);off+=2;}
  return new Blob([out],{type:'audio/wav'});
}

async function renderTrackWav(targetMinutes,muteFlags){
  const mute=muteFlags||{};
  const chain=DRUM.chain.length?DRUM.chain:[DRUM.active];
  const L=loopLen(), sp=spb(), cols=steps();
  const loopsNeeded=Math.max(chain.length,Math.ceil((targetMinutes||1)*60/L));
  const loops=Math.ceil(loopsNeeded/chain.length)*chain.length;
  const tail=Math.max(.6,P.x.verb*2.5);
  const OAC=new OfflineAudioContext(2,Math.ceil(44100*(L*loops+tail)),44100);
  const eng=buildGraph(OAC);
  const qr=quantizeEvents(REC.events).map(e=>({...e,t:L>0?((e.t%L)+L)%L:e.t}));
  /* apply recorded automation to the shared offline FX/master nodes for every loop.
     These are the params the FX Rack automates (chorus, delay, reverb, master vol).
     Per-voice params (filter cutoff, env) are captured at note-on from live P values. */
  const fxMap={
    'x.chor':n=>['chWet',n],'x.dmix':n=>['dWet',n],'x.dfb':n=>['fb',n],
    'x.verb':n=>['vWet',n],'m.vol':n=>['bus',n]
  };
  if(AUTOM.events.length&&eng.fxNodes){
    for(let loop=0;loop<loops;loop++){
      const base=loop*L;
      AUTOM.events.forEach(ev=>{
        const m=fxMap[ev.id];if(!m)return;
        const [nodeKey,val]=m(ev.v);const node=eng.fxNodes[nodeKey];
        if(node&&node.gain){try{node.gain.setValueAtTime(val,base+ev.t);}catch(_){}}
      });
    }
  }
  for(let loop=0;loop<loops;loop++){
    const base=loop*L;
    const grid=DRUM.patterns[chain[loop%chain.length]]||DRUM.grid;
    if(!mute.drums)for(let st=0;st<cols;st++){const when=base+st*sp;
      DRUM.rows.forEach(r=>{if(grid[r][st])DRUMS_OFFLINE[r](OAC,eng,when);});}
    if(!mute.synth)for(const e of qr){const when=base+e.t;
      if(e.type==='on')offlineNoteOn(OAC,eng,e.midi,when,e.vel);
      else offlineNoteOff(eng,e.midi,when);}
  }
  for(const m in eng.held)offlineNoteOff(eng,+m,loops*L);
  return audioBufferToWav(await OAC.startRendering());
}
