# Python virtual environment — dependencies are installed via requirements.txt
.venv
venv
env

# Git history
.git
.gitignore

# Claude project files
.claude

# Python bytecode and caches
__pycache__
*.pyc
*.pyo
*.pyd
.Python

# Research/backtest scripts — not needed in production
# ...except range_model.py: a pure production dependency imported by ml_predictor/infer.py
# (the NEUTRAL band). infer.py also has an inline fallback, but ship the real values.
research/*
!research/range_model.py

# Local DB — restored from HF Hub at startup
*.db
database.db
paper_trading.db

# Cache files — regenerated at runtime
fred_macro_cache.json
fundamentals_cache.json
.universe_cache.json
learnings.json
*.cache.json

# Environment files — secrets must be set as HF Space secrets, not baked in
.env
.env.*
*.env

# Editor/IDE files
.DS_Store
*.swp
*.swo
.idea
.vscode

# Test files
tests/
pytest.ini
.pytest_cache

# Logs
*.log
