{
  "buildCommand": "pip install -r requirements.txt",
  "env": {
    "PYTHONUNBUFFERED": "1",
    "PYTHONPATH": "/var/task"
  },
  "functions": {
    "scripts/run_api.py": {
      "memory": 1024,
      "maxDuration": 60,
      "runtime": "python3.11"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/scripts/run_api.py",
      "methods": ["GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS"]
    }
  ]
}
