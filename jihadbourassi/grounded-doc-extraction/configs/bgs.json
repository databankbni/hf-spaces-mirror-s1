{
  "description": "BGS domain configuration for the expert extractor. Spatial tolerances and scoring weights are PROVISIONAL defaults, not calibrated against real documents.",
  "crs": "EPSG:27700",
  "units": "metres",
  "spatial": {
    "min_y_overlap": 0.4,
    "min_x_overlap": 0.3,
    "max_gap_frac_x": 0.35,
    "max_gap_frac_y": 0.1,
    "near_frac": 0.08,
    "provenance_neighbour_frac": 0.12,
    "provenance_max_neighbours": 6,
    "row_max_gap_frac_x": 0.6,
    "row_max_centre_dy_frac": 0.012,
    "overlap_min_x": 0.5,
    "overlap_min_y": 0.15
  },
  "scoring": {
    "rule_strength": {
      "labelled_in_region": 3.0,
      "labelled_neighbour": 2.0,
      "packed_pair": 1.0
    },
    "anchor_proximity_weight": 1.0,
    "format_specificity_weight": 0.5,
    "ocr_confidence_weight": 0.25
  },
  "tie_margin": 0.15,
  "wrapper_markers": [
    "bgsid",
    "bgs id",
    "bgs reference",
    "bgs ref",
    "contact bgs",
    "single onshore borehole index",
    "bgs report"
  ],
  "fields": {
    "borehole_id": {
      "value_pattern": "[A-Za-z0-9][A-Za-z0-9/\\-\\.]{1,29}",
      "require_digit": true,
      "distinct_value_abstention": "always",
      "anchors": [
        {
          "text": "borehole no",
          "relations": [
            "same_region",
            "right",
            "below"
          ],
          "strength": "strong"
        },
        {
          "text": "borehole number",
          "relations": [
            "same_region",
            "right",
            "below"
          ],
          "strength": "strong"
        },
        {
          "text": "borehole ref",
          "relations": [
            "same_region",
            "right",
            "below"
          ],
          "strength": "strong"
        },
        {
          "text": "hole no",
          "relations": [
            "same_region",
            "right",
            "below"
          ],
          "strength": "strong"
        },
        {
          "text": "bh no",
          "relations": [
            "same_region",
            "right",
            "below"
          ],
          "strength": "strong"
        },
        {
          "text": "log of borehole",
          "relations": [
            "same_region",
            "right",
            "below"
          ],
          "strength": "strong"
        },
        {
          "text": "borehole",
          "match": "exact",
          "relations": [
            "overlap"
          ],
          "strength": "strong"
        }
      ],
      "validation": {
        "type": "format",
        "pattern": "[A-Za-z0-9][A-Za-z0-9/\\-\\.]{1,29}",
        "min_length": 2,
        "max_length": 30
      }
    },
    "easting": {
      "value_pattern": "\\d{4,7}(?:\\.\\d{1,3})?",
      "inline_patterns": [
        "(?i)(?<![A-Za-z0-9])E[\\s:]*(\\d{4,7}(?:\\.\\d{1,3})?)"
      ],
      "packed_pair_pattern": "(\\d{4,7}(?:\\.\\d{1,3})?)\\s*[,/]\\s*(\\d{4,7}(?:\\.\\d{1,3})?)",
      "packed_pair_position": 1,
      "anchors": [
        {
          "text": "easting",
          "relations": [
            "same_region",
            "right",
            "below"
          ],
          "strength": "strong"
        },
        {
          "text": "eastings",
          "relations": [
            "same_region",
            "right",
            "below"
          ],
          "strength": "strong"
        },
        {
          "text": "grid ref",
          "relations": [
            "same_region",
            "right",
            "below"
          ],
          "strength": "strong"
        },
        {
          "text": "co-ordinates",
          "relations": [
            "same_region",
            "right",
            "below"
          ],
          "strength": "strong"
        },
        {
          "text": "coordinates",
          "relations": [
            "same_region",
            "right",
            "below"
          ],
          "strength": "strong"
        }
      ],
      "validation": {
        "type": "range",
        "min": 0,
        "max": 700000
      }
    },
    "northing": {
      "value_pattern": "\\d{4,7}(?:\\.\\d{1,3})?",
      "inline_patterns": [
        "(?i)(?<![A-Za-z0-9])N[\\s:]*(\\d{4,7}(?:\\.\\d{1,3})?)"
      ],
      "packed_pair_pattern": "(\\d{4,7}(?:\\.\\d{1,3})?)\\s*[,/]\\s*(\\d{4,7}(?:\\.\\d{1,3})?)",
      "packed_pair_position": 2,
      "anchors": [
        {
          "text": "northing",
          "relations": [
            "same_region",
            "right",
            "below"
          ],
          "strength": "strong"
        },
        {
          "text": "northings",
          "relations": [
            "same_region",
            "right",
            "below"
          ],
          "strength": "strong"
        }
      ],
      "validation": {
        "type": "range",
        "min": 0,
        "max": 1300000
      }
    },
    "final_depth": {
      "value_pattern": "\\d{1,4}(?:\\.\\d{1,2})?",
      "anchors": [
        {
          "text": "final depth",
          "relations": [
            "same_region",
            "right",
            "below"
          ],
          "strength": "strong"
        },
        {
          "text": "total depth",
          "relations": [
            "same_region",
            "right",
            "below"
          ],
          "strength": "strong"
        },
        {
          "text": "depth drilled",
          "relations": [
            "same_region",
            "right",
            "below"
          ],
          "strength": "strong"
        },
        {
          "text": "end of borehole",
          "relations": [
            "same_region",
            "left",
            "above"
          ],
          "strength": "strong"
        },
        {
          "text": "end of hole",
          "relations": [
            "same_region",
            "left",
            "above"
          ],
          "strength": "strong"
        },
        {
          "text": "base of borehole",
          "relations": [
            "same_region",
            "left",
            "above"
          ],
          "strength": "strong"
        }
      ],
      "unit": {
        "metric_tokens": [
          "m",
          "m.",
          "(m)",
          "metres",
          "meters",
          "metre",
          "meter"
        ],
        "non_metric_tokens": [
          "ft",
          "ft.",
          "feet",
          "foot",
          "inch",
          "inches"
        ],
        "context_neighbour_frac": 0.25,
        "column_min_x_overlap": 0.5,
        "column_max_dy_frac": 0.8
      },
      "validation": {
        "type": "range",
        "min": 0,
        "max": 3000
      }
    }
  }
}
