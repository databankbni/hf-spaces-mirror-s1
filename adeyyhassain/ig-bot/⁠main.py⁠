def generate_web_password(password):
  timestamp = int(time.time())
  return f'#PWD_INSTAGRAM_BROWSER:0:{timestamp}:{password}'


def send_msg(chat_id, text):
  try:
    requests.post(
        f'{BASE_URL}/sendMessage', data={'chat_id': chat_id, 'text': text}
    )
  except:
    pass


def get_updates(offset=None):
  params = {'offset': offset, 'timeout': 30}
  try:
    return requests.get(
        f'{BASE_URL}/getUpdates', params=params, timeout=35
    ).json()
  except:
    return {}


def finalize_api(chat_id, web_id):
  auth_payload = (
      '{"ds_user_id":"'
      + web_id.split('%3A')[0]
      + '","sessionid":"'
      + web_id
      + '"}'
  )
  encoded_auth = base64.b64encode(auth_payload.encode('utf-8')).decode('utf-8')

  api_headers = {
      'User-Agent': (
          'Instagram 365.0.0.14.102 Android (28/9; 300dpi; 1600x900; samsung;'
          ' SM-N975F; SM-N975F; intel; en_US; 373310563)'
      ),
      'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
      'cookie': f'sessionid={web_id}',
      'X-Bloks-Version-Id': (
          '8ca96ca267e30c02cf90888d91eeff09627f0e3fd2bd9df472278c9a6c022cbb'
      ),
      'X-Bloks-Is-Layout-Rtl': 'false',
  }

  data = {
      'device_id': (
          f"android-{''.join(random.choice('1234567890') for i in range(10))}"
      ),
      'authorization_token': f'Bearer IGT:2:{encoded_auth}',
  }

  req = requests.post(
      'https://i.instagram.com/api/v1/accounts/continue_as_instagram_login/',
      headers=api_headers,
      data=data,
  )
  if 'logged' in req.text:
    sess = req.cookies.get('sessionid')
    if not sess:
      try:
        auth_header = req.headers.get('ig-set-authorization')
        after = str(base64.b64decode(auth_header.split(':')[2]))
        sess = re.search('"sessionid":"(.*?)"', after).groups()[0]
      except:
        pass
    send_msg(chat_id, f'[+] API Session Converted Successfully! 🔥\n\n`{sess}`')
  else:
    send_msg(chat_id, f'[-] Conversion failed: {req.text}')


def process_login(chat_id, username, password):
  send_msg(chat_id, f'[*] Trying to login to @{username}...')

  url = 'https://www.instagram.com/api/v1/web/accounts/login/ajax/'
  session = requests.Session()
  device_id = str(uuid.uuid4())

  headers = {
      'User-Agent': (
          'Mozilla/5.0 (iPhone; CPU iPhone OS 17_4 like Mac OS X)'
          ' AppleWebKit/605.1.15 (KHTML, like Gecko) Version/17.4 Mobile/15E148'
          ' Safari/604.1'
      ),
      'X-Requested-With': 'XMLHttpRequest',
      'Referer': 'https://www.instagram.com/accounts/login/',
      'Content-Type': 'application/x-www-form-urlencoded',
      'X-IG-App-ID': '936619743392459',
      'X-ASBD-ID': '129477',
      'X-Instagram-AJAX': '1014887308',
      'X-PICO-Session-Id': device_id,
  }

  session.get(
      'https://www.instagram.com/accounts/login/',
      headers={'User-Agent': headers['User-Agent']},
  )
  headers['X-CSRFToken'] = session.cookies.get_dict().get('csrftoken', '')
  mid = session.cookies.get_dict().get('mid', '')
  if mid:
    headers['X-MID'] = mid

  payload = {
      'username': username,
      'enc_password': generate_web_password(password),
      'queryParams': '{}',
      'optIntoOneTap': 'false',
      'trustedDeviceRecords': '{}',
  }

  response = session.post(url, headers=headers, data=payload)
  try:
    res_json = response.json()
  except:
    res_json = {}

  if res_json.get('authenticated'):
    web_id = session.cookies.get_dict().get('sessionid')
    if web_id:
      finalize_api(chat_id, web_id)
    else:
      send_msg(
          chat_id, '[-] Login successful, but web sessionid cookie was not found.'
      )
  elif res_json.get('two_factor_required'):
    send_msg(
        chat_id,
        '[!] 2FA Required! This version handles direct login. Try an account'
        ' without 2FA.',
    )
  else:
    send_msg(chat_id, f'[-] Login Failed: {res_json}')


def bot_polling():
  offset = None
  print('Telegram Bot is running smoothly...')
  while True:
    updates = get_updates(offset)
    if 'result' in updates and updates['result']:
      for update in updates['result']:
        offset = update['update_id'] + 1
        if 'message' in update and 'text' in update['message']:
          chat_id = update['message']['chat']['id']
          text = update['message']['text'].strip()

          if text == '/start':
            send_msg(
                chat_id,
                'Welcome! Send your Instagram login in this'
                ' format:\nusername:password',
            )
          elif ':' in text:
            try:
              u, p = text.split(':', 1)
              process_login(chat_id, u.strip(), p.strip())
            except Exception as e:
              send_msg(chat_id, f'[-] Error parsing input: {e}')
          else:
            send_msg(
                chat_id, '[-] Please use the correct format: username:password'
            )
    time.sleep(1)


if __name__ == '__main__':
  # Run web server in background thread for Render
  t = threading.Thread(target=run_web)
  t.start()
  # Run bot polling
  bot_polling()
