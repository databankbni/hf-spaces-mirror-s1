# Normalize line endings for all text files
* text=auto eol=lf

# Python files
*.py text eol=lf
*.pyi text eol=lf

# Config files
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.sql text eol=lf
*.md text eol=lf

# Binary files
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.docx binary
*.db binary
*.duckdb binary