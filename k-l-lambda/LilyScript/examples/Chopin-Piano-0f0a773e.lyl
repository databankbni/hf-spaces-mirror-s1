\staff "2" r8 a16( a b8\sustainOff a \\
\staff "2" d,2 | %61

\staff "1" \key a \major \time 2/4 <fs a>4\<( <es gs>8 <fs a> \\
\staff "2" r8 a16( a b8\sustainOff a \\
\staff "2" d,2 | %62

