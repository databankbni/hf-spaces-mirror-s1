\staff "2" fs2 | %51

\staff "1" \key a \major \time 2/4 <e' g>4( <ds fs>8 <e g> \\
\staff "2" r8 cs'16( cs d8\sustainOff cs \\
\staff "2" as'2 | %52

\staff "1" \key a \major \time 2/4 <d' fs>4 <b d> \\
\staff "2" r8 fs16( fs g8\sustainOff fs \\
\staff "2" b2 | %53

\staff "1" \key a \major \time 2/4 <d' f>4( <cs e>8 <d f> \\
\staff "2" r8 b'16( b c8\sustainOff b \\
\staff "2" d2 | %54

\staff "1" \key a \major \time 2/4 <e' gs>4 <d b'> \\
