\staff "1" \key a \major \time 2/4 \tuplet 3/2 { fs'16\>( ds b } \tuplet 3/2 { a16\!\> fs ds } b,8\! \tuplet 3/2 { a'''16)( b a } \\
\staff "2" \clef "bass" <b,, b'>8\sustainOn \clef "treble" <b'' ds fs a> <b ds fs a> r | %78

\staff "1" \key a \major \time 2/4 \tuplet 3/2 { gs''16\>( e b } \tuplet 3/2 { gs16\!\> e b } e,8\! \tuplet 3/2 { gs''16)( a gs } \\
