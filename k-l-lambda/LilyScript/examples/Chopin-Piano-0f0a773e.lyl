%Romantic
%Chopin, Frederic
%Keyboard
[staves "{-}"]
[instrument-1-2 "Piano" "Pno."]

\staff "1" \key a \major \time 2/4 \clef "treble" \tempo 4=110 ^\markup "Allegretto moderato." \tuplet 3/2 { e'16\pp( fs e } \\
\staff "2" \clef "bass" r8 | %1

\staff "1" \key a \major \time 2/4 cs'16\>( a fs e\! r8 \tuplet 3/2 { e'16\>( fs e } \\
\staff "2" a,,8\sustainOn <e'' a cs> <e a cs> r | %2

\staff "1" \key a \major \time 2/4 d'16\>( b gs e\! r8 \tuplet 3/2 { e'16\>( fs e } \\
\staff "2" a,,8\sustainOn <e'' b' d> <e b' d> r | %3

\staff "1" \key a \major \time 2/4 \tuplet 3/2 { a''16\>( gs fs } \tuplet 3/2 { fs16)\!\>( e d } \tuplet 3/2 { d16)\!\>( cs b } \tuplet 3/2 { b16)\!\>( a gs } \\
\staff "2" a,,8\sustainOn <e'' b' d> a, <e' b' d>\sustainOff | %4

\staff "1" \key a \major \time 2/4 \tuplet 3/2 { a'16\>( b bs } \tuplet 3/2 { cs16\!\> a fs } e8\! \tuplet 3/2 { e'16)\>( fs e } \\
\staff "2" a,8\sustainOn <e' a cs> <e a cs> r | %5

\staff "1" \key a \major \time 2/4 cs'16\>( a fs e\! r8 \tuplet 3/2 { e'16\>( fs e } \\
\staff "2" a,,8\sustainOn <e'' a cs> <e a cs> r | %6

\staff "1" \key a \major \time 2/4 ds'16\>( b gs e\! r8 \tuplet 3/2 { e'16\>( fs e } \\
\staff "2" b,,8\sustainOn <e' gs b> <e gs b> r | %7

\staff "1" \key a \major \time 2/4 \tuplet 3/2 { ds'16\>( cs' b } \tuplet 3/2 { b,16)\!\>( gs' fs } \tuplet 3/2 { a,16)\!\>( gs' fs } \tuplet 3/2 { fs,16)\!\>( cs' b } \\
\staff "2" b,,8\sustainOn <fs'' a ds> b, <a' b ds>\sustainOff | %8

\staff "1" \key a \major \time 2/4 \tuplet 3/2 { e16\>( gs b } \tuplet 3/2 { e16\!\> gs b } e8\! \tuplet 3/2 { e,16)( fs e } \\
\staff "2" e,,8\sustainOn <gs' b e> <gs b e> r | %9

\staff "1" \key a \major \time 2/4 cs'16\>( a fs e\! r8 \tuplet 3/2 { e'16\>( fs e } \\
\staff "2" a,,8\sustainOn <e'' a cs> <e a cs> r | %10

\staff "1" \key a \major \time 2/4 d'16\>( b gs e\! r8 \tuplet 3/2 { e'16\>( fs e } \\
\staff "2" a,,8\sustainOn <e'' b' d> <e b' d> r | %11

\staff "1" \key a \major \time 2/4 \tuplet 3/2 { a''16\>( gs fs } \tuplet 3/2 { fs16)\!\>( e d } \tuplet 3/2 { d16)\!\>( cs b } \tuplet 3/2 { b16)\!\>( a gs } \\
\staff "2" a,,8\sustainOn <e'' b' d> a, <e' b' d>\sustainOff | %12

\staff "1" \key a \major \time 2/4 \tuplet 3/2 { a'16\>( b bs } \tuplet 3/2 { cs16\!\> a fs } e8\! \tuplet 3/2 { e'16)\>( fs e } \\
\staff "2" a,8\sustainOn <e' a cs> <e a cs> r | %13

\staff "1" \key a \major \time 2/4 cs'16\>( as fs e\! r8 \tuplet 3/2 { e'16\>( fs e } \\
\staff "2" fs,,8\sustainOn <fs' as e'> <fs as e'> r | %14

\staff "1" \key a \major \time 2/4 d'16\>( b fs d\! r8 \tuplet 3/2 { d'16\>( e d } \\
\staff "2" b,,8\sustainOn <fs'' b d> <fs b d> r | %15

\staff "1" \key a \major \time 2/4 \tuplet 3/2 { cs'16\>( b fs } \tuplet 3/2 { fs16)\!\>( e ds } \tuplet 3/2 { ds16)\!\>( cs b } \tuplet 3/2 { b16)\!\>( cs ds } \\
\staff "2" e,,8\sustainOn <b' ds a'> e,\sustainOff <b' ds a'> | %16

\staff "1" \key a \major \time 2/4 \tuplet 3/2 { e16\>( gs b } \tuplet 3/2 { e16\!\> gs b } e8\! e,)\mf( \bar "||" \\
\staff "2" e,,8\sustainOn <e' gs b> <e gs b> r \bar "||" | %17

\staff "1" \key a \major \time 2/4 d''8.-> b16 fs8.-> gs16 \\
\staff "1" d''16 e, e8 fs16 e e8 \\
\staff "2" e,,8\sustainOn <e' gs d'> e, <e' gs d'>\sustainOff | %18

\staff "1" \key a \major \time 2/4 b''8.(-> a16 e8.-> cs16 \\
\staff "1" b''16 e, e8 e16 cs cs8 \\
\staff "2" a,8\sustainOn <e' a cs> a, <e' a cs>\sustainOff | %19

\staff "1" \key a \major \time 2/4 e'8.(-> d16 as8.-> b16 \\
\staff "1" e'16 gs, gs8 b16 gs gs8 \\
\staff "2" e,,8\sustainOn <e' gs d'> e, <e' gs d'>\sustainOff | %20

\staff "1" \key a \major \time 2/4 bs'8.(-> cs16 a8.-> e'16 \\
\staff "1" bs'16 a a8 cs16 a a8 \\
\staff "2" a,8\sustainOn <e' a cs> a, <e' a cs>\sustainOff | %21

\staff "1" \key a \major \time 2/4 d''8.(-> b16 fs8.-> gs16 \\
\staff "1" d''16 e, e8 fs16 e e8 \\
\staff "2" e,,8\sustainOn <e' gs d'> e, <e' gs d'>\sustainOff | %22

\staff "1" \key a \major \time 2/4 b''8.(-> a16 e8.-> cs16 \\
\staff "1" b''16 e, e8 e16 cs cs8 \\
\staff "2" a,8\sustainOn <e' a cs> a, <e' a cs>\sustainOff | %23

\staff "1" \key a \major \time 2/4 e'8.(-> ds16 gs8.-> fs16 \\
\staff "1" e'16 b b8 gs'16 ds ds8 \\
\staff "2" b,8\sustainOn \clef "treble" <b' e gs> b, <b' ds a'>\sustainOff | %24

\staff "1" \key a \major \time 2/4 a''8.(-> gs16 cs8.-> b16 \\
