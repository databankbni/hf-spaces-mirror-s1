\staff "1" b''16 e, e8 e16 cs cs8 \\
\staff "2" a,8\sustainOn <e' a cs> a, <e' a cs>\sustainOff | %27

\staff "1" \key a \major \time 2/4 e'8.(-> d16 as8.-> b16 \\
\staff "1" e'16 gs, gs8 b16 gs gs8 \\
\staff "2" e,,8\sustainOn <e' gs d'> e, <e' gs d'>\sustainOff | %28

\staff "1" \key a \major \time 2/4 bs'8.(-> cs16 a8.-> e'16 \\
\staff "1" bs'16 a a8 cs16 a a8 \\
\staff "2" a,8\sustainOn <e' a cs> a, <e' a cs>\sustainOff | %29

\staff "1" \key a \major \time 2/4 d''8.(-> b16 fs8.-> gs16 \\
\staff "1" d''16 e, e8 fs16 e e8 \\
\staff "2" e,,8\sustainOn <e' gs d'> e, <e' gs d'>\sustainOff | %30

\staff "1" \key a \major \time 2/4 b''8.(-> a16 g8.-> e16 \\
\staff "1" b''16 e, e8 g16 a, a8 \\
\staff "2" a,8\sustainOn <e' a cs> cs <e a e'>\sustainOff | %31

\staff "1" \key a \major \time 2/4 g''8.(-> fs16 e8.-> gs,16 \\
\staff "1" g''16 a, a8 e'16 d, d8 \\
\staff "2" d,8\sustainOn <a' d fs> e\sustainOff\sustainOn <b' d> | %32

\staff "1" \key a \major \time 2/4 b'4\>(-> a8\! \bar "||" \\
\staff "1" b'16 <d, e> <d e>8 <cs e> s \bar "||" \\
\staff "2" a,8\sustainOn <e' gs d'> <a cs>\sustainOff r \bar "||" | %33

\staff "1" \key a \major \time 2/4 \key d \major <d fs>4\pp( <cs e>8 <d fs> \\
\staff "2" \key d \major r8 a16( a b8\sustainOff a \\
\staff "2" \key d \major d,2 | %34

\staff "1" \key a \major \time 2/4 <fs a>4 <e g> \\
\staff "2" r8 a16( a b8\sustainOff a \\
\staff "2" cs,2 | %35

\staff "1" \key a \major \time 2/4 <cs e>4( <b d>8 <cs e> \\
\staff "2" r8 a16( a b8\sustainOff a \\
\staff "2" a,2 | %36

\staff "1" \key a \major \time 2/4 <e g>4 <d fs> \\
\staff "2" r8 a16( a b8\sustainOff a \\
\staff "2" d,2 | %37

