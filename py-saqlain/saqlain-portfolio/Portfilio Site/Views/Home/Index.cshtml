@model List<Portfilio_Site.Models.ProjectModel>

@{
    ViewData["Title"] = "Home";
}

<section id="hero" class="min-vh-100 d-flex align-items-center text-center bg-transparent">
    <div class="container position-relative" style="z-index: 1;" data-aos="zoom-in" data-aos-duration="1000">

        <p class="text-info font-monospace mb-3 fs-4" data-aos="fade-down" data-aos-delay="200">Hello, I'm</p>

        <h1 class="fw-bolder text-white mb-3" style="font-size: clamp(3.5rem, 8vw, 5.5rem); letter-spacing: -2px;">
            Saqlain <span class="text-info">Rashid</span>
        </h1>

        <h3 class="text-secondary mb-5 fw-light fs-4" data-aos="fade-up" data-aos-delay="400">
            Passionate <span class="text-info fw-bold">Software Engineer & AI Enthusiast</span>
        </h3>

        <div class="d-flex justify-content-center gap-3 mb-5 flex-wrap" data-aos="fade-up" data-aos-delay="600">
            <a href="#projects" class="btn btn-info rounded-pill text-dark fw-bold px-5 py-3 shadow-lg hover-scale">
                <i class="fas fa-briefcase me-2"></i> View My Work
            </a>
            <a href="#contact" class="btn btn-outline-secondary rounded-pill text-light px-5 py-3 fw-bold shadow-lg hover-scale border-2">
                <i class="fas fa-envelope me-2"></i> Contact Me
            </a>
        </div>

        <div class="d-flex align-items-center justify-content-center mb-4" data-aos="fade-up" data-aos-delay="800">
            <div class="bg-secondary" style="height: 1px; width: 50px; opacity: 0.5;"></div>
            <span class="text-secondary px-3 font-monospace small tracking-wide">CONNECT WITH ME</span>
            <div class="bg-secondary" style="height: 1px; width: 50px; opacity: 0.5;"></div>
        </div>

        <div class="d-flex justify-content-center gap-4" data-aos="fade-up" data-aos-delay="1000">
            <a href="https://github.com/Py-saqlain" target="_blank" title="GitHub Profile"
               class="btn btn-outline-info rounded-circle d-flex align-items-center justify-content-center hover-scale shadow-sm border-2"
               style="width: 65px; height: 65px; font-size: 1.8rem;">
                <i class="fab fa-github"></i>
            </a>

            <a href="https://www.linkedin.com/in/py-saqlain/" target="_blank" title="LinkedIn Profile"
               class="btn btn-outline-info rounded-circle d-flex align-items-center justify-content-center hover-scale shadow-sm border-2"
               style="width: 65px; height: 65px; font-size: 1.8rem;">
                <i class="fab fa-linkedin-in"></i>
            </a>
        </div>

    </div>
</section>

<section id="about" class="py-5 bg-dark text-light border-top border-secondary min-vh-100 d-flex align-items-center">
    <div class="container py-5" data-aos="fade-up">

        <!-- Title Row -->
        <div class="row mb-5">
            <div class="col-12 text-center">
                <h2 class="display-5 fw-bold text-white mb-3">About <span class="text-info">Me</span></h2>
                <div class="mx-auto bg-info" style="height: 4px; width: 60px; border-radius: 2px;"></div>
            </div>
        </div>

        <!-- Content Row -->
        <div class="row gy-5 align-items-center">

            <!-- Left Column: Heavy AI Copy -->
            <div class="col-lg-7 pe-lg-5">
                <h3 class="h4 text-info mb-3">AI Engineer & Intelligent Systems Specialist</h3>

                <p class="lead" style="line-height: 1.8; font-size: 1.1rem;">
                    I am an undergraduate student (Batch 2027) at <strong>Punjab University College of Information Technology (PUCIT)</strong>. My engineering journey is driven by a passion for bridging the gap between high-performance backend layers and sophisticated artificial intelligence.
                </p>

                <p style="line-height: 1.8; color: #adb5bd;">
                    Today, my core focus revolves around designing multimodal AI architectures and streaming data pipelines. I specialize in building ultra-low latency voice agents utilizing <strong>LiveKit, Groq, Cartesia, and ElevenLabs APIs</strong>, as well as developing advanced <strong>RAG applications</strong> powered by <strong>LangChain, LangGraph, and Vector Embeddings</strong> for modern contextual retrieval.
                </p>

                <p style="line-height: 1.8; color: #adb5bd;">
                    When I am not orchestrating scalable containerized microservices via <strong>Docker & GitHub Actions</strong>, I am busy developing robust micro-services with <strong>.NET Core (C#) & FastAPI</strong> or tuning predictive architectures with <strong>TensorFlow and scikit-learn</strong>.
                </p>
            </div>

            <!-- Right Column: Re-mapped Profile Card -->
            <div class="col-lg-5">
                <div class="card bg-transparent border-info shadow-lg h-100 rounded-4" style="border-width: 2px;">
                    <div class="card-body p-4 p-md-5">
                        <h4 class="card-title text-white mb-4 fw-bold">
                            <i class="fas fa-terminal text-info me-2"></i> Quick Profile
                        </h4>

                        <ul class="list-unstyled mb-0" style="font-size: 1.05rem;">
                            <li class="mb-3 border-bottom border-secondary pb-3 d-flex justify-content-between">
                                <span class="text-info fw-bold"><i class="fas fa-graduation-cap me-2"></i> Education</span>
                                <span class="text-light text-end">PUCIT (2027)</span>
                            </li>
                            <li class="mb-3 border-bottom border-secondary pb-3 d-flex justify-content-between">
                                <span class="text-info fw-bold"><i class="fas fa-brain me-2"></i> AI / ML Stack</span>
                                <span class="text-light text-end">Gen AI, RAG, Vector Data</span>
                            </li>
                            <li class="mb-3 border-bottom border-secondary pb-3 d-flex justify-content-between">
                                <span class="text-info fw-bold"><i class="fas fa-microphone-alt me-2"></i> Voice APIs</span>
                                <span class="text-light text-end">LiveKit, Cartesia</span>
                            </li>
                            <li class="mb-3 border-bottom border-secondary pb-3 d-flex justify-content-between">
                                <span class="text-info fw-bold"><i class="fas fa-server me-2"></i> Backend</span>
                                <span class="text-light text-end">C# .NET, FastAPI</span>
                            </li>
                            <li class="mb-3 border-bottom border-secondary pb-3 d-flex justify-content-between">
                                <span class="text-info fw-bold"><i class="fas fa-cubes me-2"></i> DevOps</span>
                                <span class="text-light text-end">Docker, CI/CD</span>
                            </li>
                            <li class="pt-2 d-flex justify-content-between">
                                <span class="text-info fw-bold"><i class="fas fa-map-marker-alt me-2"></i> Location</span>
                                <span class="text-light text-end">Lahore, Pakistan</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>
@* skills *@

<!-- Custom Style for the Hover Glow Effect -->
<style>
    .skill-card {
        transition: all 0.3s ease-in-out !important;
        border-color: rgba(13, 202, 240, 0.2) !important;
    }

        .skill-card:hover {
            transform: translateY(-8px);
            border-color: #0dcaf0 !important;
            box-shadow: 0 10px 30px rgba(13, 202, 240, 0.25) !important;
            background-color: #212529 !important;
        }

        .skill-card i {
            transition: transform 0.3s ease;
        }

        .skill-card:hover i {
            transform: scale(1.1);
        }
</style>

<section id="skills" class="py-5 bg-dark text-light border-top border-secondary">
    <div class="container py-5" data-aos="fade-up">

        <!-- Matches your exact 'My Projects' heading style -->
        <div class="row mb-5">
            <div class="col-12 text-center">
                <h2 class="display-5 fw-bold text-white mb-3">My <span class="text-info">Skills</span></h2>
                <div class="mx-auto bg-info" style="height: 4px; width: 60px; border-radius: 2px;"></div>
            </div>
        </div>

        <div class="row g-4">

            <!-- 1. Generative AI & LLMs -->
            <div class="col-md-4">
                <div class="card h-100 bg-dark text-center p-4 skill-card">
                    <div class="mb-3">
                        <i class="fas fa-robot fa-3x text-info"></i>
                    </div>
                    <h4 class="fw-bold text-light">Generative AI & LLMs</h4>
                    <p class="text-secondary mt-3">
                        LangChain, LangGraph, RAG, OpenAI API, Groq, Prompt Engineering, FAISS, Vector Embeddings
                    </p>
                </div>
            </div>

            <!-- 2. Deep Learning -->
            <div class="col-md-4">
                <div class="card h-100 bg-dark text-center p-4 skill-card">
                    <div class="mb-3">
                        <i class="fas fa-network-wired fa-3x text-info"></i>
                    </div>
                    <h4 class="fw-bold text-light">Deep Learning</h4>
                    <p class="text-secondary mt-3">
                        TensorFlow, CNNs, LSTMs, GRUs, Keras, Time-Series
                    </p>
                </div>
            </div>

            <!-- 3. Backend & APIs -->
            <div class="col-md-4">
                <div class="card h-100 bg-dark text-center p-4 skill-card">
                    <div class="mb-3">
                        <i class="fas fa-server fa-3x text-info"></i>
                    </div>
                    <h4 class="fw-bold text-light">Backend & APIs</h4>
                    <p class="text-secondary mt-3">
                        .NET Core 8, C#, ASP.NET, FastAPI, RESTful APIs, SQL
                    </p>
                </div>
            </div>

            <!-- 4. Languages -->
            <div class="col-md-4">
                <div class="card h-100 bg-dark text-center p-4 skill-card">
                    <div class="mb-3">
                        <i class="fas fa-code fa-3x text-info"></i>
                    </div>
                    <h4 class="fw-bold text-light">Languages</h4>
                    <p class="text-secondary mt-3">
                        Python, C#, C++, C, JavaScript, SQL
                    </p>
                </div>
            </div>

            <!-- 5. Machine Learning -->
            <div class="col-md-4">
                <div class="card h-100 bg-dark text-center p-4 skill-card">
                    <div class="mb-3">
                        <i class="fas fa-brain fa-3x text-info"></i>
                    </div>
                    <h4 class="fw-bold text-light">Machine Learning</h4>
                    <p class="text-secondary mt-3">
                        scikit-learn, Feature Engineering, LiveKit, Cartesia, ElevenLabs APIs, Predictive Modeling
                    </p>
                </div>
            </div>

            <!-- 6. DevOps & Tools -->
            <div class="col-md-4">
                <div class="card h-100 bg-dark text-center p-4 skill-card">
                    <div class="mb-3">
                        <i class="fas fa-box-open fa-3x text-info"></i>
                    </div>
                    <h4 class="fw-bold text-light">DevOps & Tools</h4>
                    <p class="text-secondary mt-3">
                        Docker, GitHub Actions (CI/CD), Git, Streamlit, HuggingFace
                    </p>
                </div>
            </div>

        </div>
    </div>
</section>

 @* Projects *@
<section id="projects" class="py-5 bg-dark text-light border-top border-secondary min-vh-100 d-flex align-items-center">
    <div class="container py-5">

        <div class="row mb-5" data-aos="fade-up">
            <div class="col-12 text-center">
                <h2 class="display-5 fw-bold text-white mb-3">My <span class="text-info">Projects</span></h2>
                <div class="mx-auto bg-info" style="height: 4px; width: 60px; border-radius: 2px;"></div>
            </div>
        </div>

        <div class="row gy-4">
            @foreach (var project in Model)
            {
                <div class="col-md-6 col-lg-4" data-aos="flip-up" data-aos-duration="1000">
                    <div class="card bg-transparent border-info h-100 shadow-lg rounded-4 hover-scale" style="border-width: 2px; transition: transform 0.3s ease;">

                        <div class="card-body p-4 d-flex flex-column">
                            <h4 class="card-title text-white fw-bold mb-3">@project.Title</h4>

                            <div class="mb-3">
                                <span class="badge bg-dark text-info border border-info px-2 py-1 text-wrap lh-base" style="font-size: 0.85rem;">
                                    <i class="fas fa-layer-group me-1"></i> @project.TechStack
                                </span>
                            </div>

                            <p class="card-text text-secondary mt-2 flex-grow-1" style="line-height: 1.6;">@project.Description</p>
                        </div>

                        <!-- Card Footer with Dynamic Buttons -->
                        <div class="card-footer bg-transparent border-0 p-4 pt-0 mt-auto">
                            <div class="d-flex gap-2">
                                <!-- GitHub Code Button (Always shows) -->
                                <a href="@project.GithubLink" target="_blank" class="btn btn-outline-info w-100 rounded-pill fw-bold shadow-sm">
                                    <i class="fab fa-github fa-lg me-1"></i> Code
                                </a>

                                <!-- Conditional Live Demo Button -->
                                @if (!string.IsNullOrEmpty(project.LiveUrl))
                                {
                                    <a href="@project.LiveUrl" target="_blank" class="btn btn-info text-dark w-100 rounded-pill fw-bold shadow-sm">
                                        <i class="fas fa-external-link-alt me-1"></i> Live
                                    </a>
                                }
                            </div>
                        </div>

                    </div>
                </div>
            }
        </div>
    </div>
</section>

 @* Certificate & internships *@
<!-- Custom Style for Split Screen Layout -->
<style>
    .split-card {
        transition: all 0.3s ease-in-out !important;
        border-color: rgba(13, 202, 240, 0.15) !important;
        background-color: rgba(33, 37, 41, 0.5) !important;
    }

        .split-card:hover {
            transform: translateY(-3px);
            border-color: #0dcaf0 !important;
            box-shadow: 0 8px 20px rgba(13, 202, 240, 0.1) !important;
        }

    .clickable-card {
        text-decoration: none;
        display: block;
    }

        .clickable-card:hover .card-title-hover {
            color: #0dcaf0 !important;
        }
</style>

<section id="experience-education" class="py-5 bg-dark text-light border-top border-secondary">
    <div class="container py-5">
        <div class="row g-5">

            <!-- LEFT COLUMN: CERTIFICATIONS -->
            <div class="col-lg-6" data-aos="fade-right" data-aos-duration="1000">
                <div class="d-flex align-items-center mb-4">
                    <div class="bg-info text-dark rounded-circle p-2 me-3 d-flex align-items-center justify-content-center" style="width: 45px; height: 45px;">
                        <i class="fas fa-certificate fa-lg"></i>
                    </div>
                    <h3 class="fw-bold text-white mb-0">Certifications</h3>
                </div>

                <div class="d-flex flex-column gap-3">
                    @if (ViewBag.Certifications != null)
                    {
                        foreach (var cert in (List<Portfilio_Site.Models.CertificationModel>)ViewBag.Certifications)
                        {
                            <a href="@cert.CredentialUrl" target="_blank" class="clickable-card">
                                <div class="card p-4 split-card border rounded-4 h-100">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <h5 class="fw-bold text-white card-title-hover mb-0 transition-all">@cert.Title</h5>
                                        <i class="fas fa-external-link-alt text-secondary fa-sm ms-2 mt-1"></i>
                                    </div>
                                    <p class="text-info small mb-0 fw-semibold">
                                        <i class="fas fa-university me-1 opacity-75"></i> @cert.IssuingOrganization
                                    </p>
                                </div>
                            </a>
                        }
                    }
                </div>
            </div>

            <!-- RIGHT COLUMN: INTERNSHIPS -->
            <div class="col-lg-6" data-aos="fade-left" data-aos-duration="1000">
                <div class="d-flex align-items-center mb-4">
                    <div class="bg-info text-dark rounded-circle p-2 me-3 d-flex align-items-center justify-content-center" style="width: 45px; height: 45px;">
                        <i class="fas fa-briefcase fa-lg"></i>
                    </div>
                    <h3 class="fw-bold text-white mb-0">Internships</h3>
                </div>

                <div class="d-flex flex-column gap-3">
                    @if (ViewBag.Internships != null)
                    {
                        foreach (var intern in (List<Portfilio_Site.Models.InternshipModel>)ViewBag.Internships)
                        {
                            <div class="card p-4 split-card border rounded-4">
                                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                                    <h5 class="fw-bold text-white mb-0">@intern.Role</h5>
                                    <span class="badge bg-dark text-info border border-info px-2 py-1" style="font-size: 0.8rem;">
                                        <i class="far fa-calendar-alt me-1"></i> @intern.Duration
                                    </span>
                                </div>
                                <p class="text-secondary fw-semibold small mb-2">
                                    <i class="fas fa-building me-1 text-info opacity-75"></i> @intern.Company
                                </p>
                                <p class="text-secondary mb-0 small" style="line-height: 1.5;">@intern.Description</p>
                            </div>
                        }
                    }
                </div>
            </div>

        </div>
    </div>
</section>



