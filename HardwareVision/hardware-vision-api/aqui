        dados = gemini_json(prompt)
        return {"sucesso": True, "faixa": dados.get("faixa",""),
                "nota": dados.get("nota",""), "componente_normalizado": identificador}
    except Exception as e:
        return {"sucesso": False, "erro": str(e)}

