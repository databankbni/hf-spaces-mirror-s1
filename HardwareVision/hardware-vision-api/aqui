@app.get("/sugestoes")
async def sugestoes():
    prompt = (
        "Gere exatamente 6 modelos populares de notebooks ou PCs.\n"
        "Apenas marca + linha (ex: 'Dell Inspiron', 'Lenovo IdeaPad').\n"
        "Responda SOMENTE JSON: {\"modelos\": [\"Modelo 1\", ...]}"
