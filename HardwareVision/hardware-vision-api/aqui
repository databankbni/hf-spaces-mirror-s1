@app.post("/raiox")
async def raiox(
    imagem:     UploadFile = File(None),
    componente: str        = Form("componente de hardware"),
):
    try:
        b = await imagem.read() if imagem else None
        if not b:
            return {"sucesso": True, "laudo": {
                "status":"atencao","titulo":"Análise sem imagem",
                "texto":f"Pause a câmera sobre o {componente} e tente novamente.",
                "recomendacao":"Pause a câmera sobre o componente.",
                "pontuacao":50,"pins":[]}}

        prompt = (
            f"Técnico especialista em hardware. Analise '{componente}' na imagem.\n"
            f"Sistema de coordenadas: x=0 esquerda, x=1000 direita, y=0 topo, y=1000 base.\n"
            f"Responda SOMENTE JSON puro sem markdown:\n"
            f'{{"divergente":false,"status":"saudavel","titulo":"Resumo 5 palavras",'
            f'"texto":"Descrição técnica 2-3 frases.","recomendacao":"Ação em 1 frase.",'
            f'"pontuacao":85,"pins":[{{"id":1,"x":500,"y":300,"label":"Chip","status":"ok",'
            f'"detalhe":"Detalhe técnico do elemento."}}]}}\n'
            f"- status: saudavel(80-100), atencao(50-79), critico(0-49)\n"
            f"- pins.status: ok=verde, atencao=amarelo, critico=vermelho, info=azul\n"
            f"- Gere 4-10 pins em elementos DIFERENTES e bem separados (distância mínima 100)\n"
            f"- divergente=true somente se imagem mostrar CLARAMENTE outro componente"
        )
        resultado = gemini_json(prompt, b)
        resultado.setdefault("pins", [])
        resultado.setdefault("divergente", False)
        if resultado.get("divergente"):
            resultado["pins"] = []
        return {"sucesso": True, "laudo": resultado}
    except Exception as e:
        return {"sucesso": False, "erro": str(e)}

