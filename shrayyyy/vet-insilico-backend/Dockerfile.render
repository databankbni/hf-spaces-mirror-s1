FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Install build deps + OpenBabel + boost (Vina needs boost)
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-dev \
    build-essential cmake \
    libboost-all-dev libeigen3-dev \
    libgomp1 libfreetype6 libxft-dev libffi-dev \
    openbabel libopenbabel-dev \
    git wget \
    && rm -rf /var/lib/apt/lists/*

# Build Vina from source (static)
RUN git clone https://github.com/ccsb-scripps/AutoDock-Vina.git /tmp/vina \
    && cd /tmp/vina/build/linux/release \
    && make \
    && cp vina /usr/local/bin/vina \
    && cp vina_split /usr/local/bin/vina_split \
    && rm -rf /tmp/vina

# Install Python deps
RUN pip3 install --no-cache-dir \
    fastapi==0.115.0 \
    uvicorn==0.30.0 \
    rdkit==2024.3.5 \
    pydantic==2.9.0 \
    numpy==1.26.4 \
    meeko==0.5.0 \
    requests==2.32.3

WORKDIR /app
COPY . .

EXPOSE 10000

CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "10000"]
